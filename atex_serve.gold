import os;
import json;
import dictionary;
struct Page { fname byte[..64], idx int, used int }
struct Entry { koff int, klen int, page int, off int, len int, src_bytes int, mt int }
struct Hit { id int, score int, conf int }
var ADIR byte[>..];
var PAGES Page[>..];
var PDATA byte[>..][>..];
var ENTRIES Entry[>..];
var KIDX dictionary<uint, int>;
var KARENA byte[>..];
var GBUILT = false;
var VOCAB dictionary<uint, int>;
var VARENA byte[>..];
var VOFF int[>..];
var LASTID int[>..];
var PAIRS int[>..];
var OFFS int[>..];
var PST int[>..];
var TEX_W = 4096;
var LAST_SIG = 0 as uint;
var WRITE_OK = true;
var ROOTS byte[>..][>..];
var LAST_SWEEP = 0;
var SW_GAP = 500000000;
var SW_APPLY = false;
var SW_DIRTY = false;
var SW_MISSING = false;
var SW_SEEN bool[>..];
var SW_SKIP dictionary<uint, int>;
var WH_ID int[>..];
var FUZZY_ID byte[>..];
var LOCK_DEPTH = 0;
var LOCK_BEAT = 0;
let LOCK_WAIT_MS = 40000;
let LOCK_STALE_S = 30;
var PAGE_W = 4096;
var PAGE_H = 64;
var PAGE_BYTES = 1048576;
var DEF_K = 3;
var DEF_MC = 600;
fn is_stop(w const byte[:]) bool {
	let n = w.len;
	if n > 7 { return false; }
	let c0 = w[0];
	if n == 2 { return w == "to" || w == "in" || w == "is" || w == "of" || w == "or" || w == "on" || w == "at" || w == "by" || w == "as" || w == "it" || w == "be" || w == "do" || w == "an" || w == "my"; }
	if n == 3 { return w == "the" || w == "and" || w == "for" || w == "are" || w == "how" || w == "can" || w == "use" || w == "any" || w == "has" || w == "get" || w == "set" || w == "put"; }
	if n == 4 { return (c0 == 't' && (w == "this" || w == "that" || w == "tell")) || (c0 == 'w' && (w == "what" || w == "with" || w == "will")) || w == "from" || w == "some" || w == "have" || w == "make" || w == "show" || w == "give" || w == "help"; }
	if n == 5 { return w == "using" || w == "would" || w == "could"; }
	w == "should" || w == "please"
}
fn is_tok_start(c byte) bool { (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') }
fn is_tok_lead(c byte) bool { is_tok_start(c) || (c >= '0' && c <= '9') }
fn is_plural(w const byte[:]) bool { w.len > 3 && w[w.len - 1] == 's' && w[w.len - 2] != 's' && is_tok_start(w[w.len - 2]) }
fn stem_y(w const byte[:]) const byte[:] { if w.len > 4 && ends_with(w, "y") && !is_stop(w) { w[..w.len - 1] } else { w } }
fn has_word(h const byte[:], w const byte[:]) bool {
	var from = 0;
	while from < h.len {
		let p = find(h[from..], w);
		if p < 0 { return false; }
		let at = from + p;
		if at == 0 || !(is_tok_lead(h[at - 1])) { return true; }
		from = at + 1;
	}
	false
}
fn is_tok_cont(c byte) bool { is_tok_start(c) || (c >= '0' && c <= '9') || c == '_' || c == '-' || c == '.' }
fn ensure_page_loaded(p int) {
	while PDATA.len <= p {
		var empty byte[>..] = [];
		PDATA.push(copy(empty));
	}
	if PDATA[p].len == 0 && p < PAGES.len {
		let path = str(ADIR, "/pages/", PAGES[p].fname);
		read_file(path, PDATA[p]);
	}
}
fn entry_text(id int) const byte[:] {
	let e .= ENTRIES[id];
	ensure_page_loaded(e.page);
	let d .= PDATA[e.page];
	if e.off >= 0 && e.off + e.len <= d.len { d[e.off..e.off + e.len] } else { "" }
}
fn ekey(id int) const byte[:] { KARENA[ENTRIES[id].koff..ENTRIES[id].koff + ENTRIES[id].klen] }
fn kfind(k const byte[:]) int {
	var h = hash(k);
	while contains(KIDX, h) {
		let n = get(KIDX, h, 0);
		if ekey(n) == k { return n; }
		h = (h >> 1) ^ 0x5bd1e9955bd1e995;
	}
	-1
}
fn kadd(id int) {
	var h = hash(ekey(id));
	while contains(KIDX, h) { h = (h >> 1) ^ 0x5bd1e9955bd1e995; }
	insert(KIDX, h, id);
}
fn nonce_find(w const byte[:]) int {
	var h = hash(w);
	while contains(VOCAB, h) {
		let n = get(VOCAB, h, 0);
		if word_at(n) == w { return n; }
		h = (h >> 1) ^ 0x5bd1e9955bd1e995;
	}
	-1
}
fn nonce_add(w const byte[:]) int {
	var h = hash(w);
	while contains(VOCAB, h) {
		let n = get(VOCAB, h, 0);
		if word_at(n) == w { return n; }
		h = (h >> 1) ^ 0x5bd1e9955bd1e995;
	}
	let n = VOFF.len;
	VOFF.push(VARENA.len);
	VARENA.append(w);
	LASTID.push(-1);
	insert(VOCAB, h, n);
	n
}
fn post_word(w const byte[:], id int) {
	if is_plural(w) { post_word(w[..w.len - 1], id); }
	if w.len < 2 || is_stop(w) { return; }
	let n = nonce_add(w);
	if LASTID[n] != id { LASTID[n] = id; PAIRS.push(n); PAIRS.push(id); }
}
fn postings(n int, out int[>..]&) {
	if n < 0 { return; }
	if n + 1 < OFFS.len { for j in OFFS[n]..OFFS[n + 1] { out.push(PST[j]); } }
	var j = 0;
	while j + 1 < PAIRS.len { if PAIRS[j] == n { out.push(PAIRS[j + 1]); } j += 2; }
}
fn finalize_lut() {
	let nv = VOFF.len;
	OFFS.clear();
	OFFS.resize(nv + 1, 0);
	var j = 0;
	while j + 1 < PAIRS.len { OFFS[PAIRS[j] + 1] += 1; j += 2; }
	for n in 0..nv { OFFS[n + 1] += OFFS[n]; }
	PST.clear();
	PST.resize(OFFS[nv], 0);
	var cur int[>..] = [];
	cur.append(OFFS[..nv]);
	j = 0;
	while j + 1 < PAIRS.len { let n = PAIRS[j]; PST[cur[n]] = PAIRS[j + 1]; cur[n] += 1; j += 2; }
	PAIRS.clear();
}
fn word_at(n int) const byte[:] {
	let e = if n + 1 < VOFF.len { VOFF[n + 1] } else { VARENA.len };
	VARENA[VOFF[n]..e]
}
fn index_text(s const byte[:], id int) {
	var i = 0;
	var w byte[..128] = [];
	var sub byte[..128] = [];
	while i < s.len {
		if is_tok_lead(s[i]) {
			let a = i;
			i += 1;
			while i < s.len && is_tok_cont(s[i]) { i += 1; }
			if i - a >= 2 {
				w.clear();
				var has_sep = false;
				for k in a..min(i, a + 128) {
					let lc = lower(s[k]);
					if lc == '_' || lc == '-' || lc == '.' { has_sep = true; }
					w.push(lc);
				}
				post_word(w[..], id);
				if has_sep {
					sub.clear();
					for k in 0..w.len {
						let c = w[k];
						if c == '_' || c == '-' || c == '.' { post_word(sub[..], id); sub.clear(); } else { sub.push(c); }
					}
					post_word(sub[..], id);
				}
			}
		} else { i += 1; }
	}
}
fn grid_insert(id int, key const byte[:], text const byte[:]) {
	index_text(key, id);
	index_text(text, id);
}
fn put_u32(out byte[>..]&, v int) {
	out.push((v & 255) as byte);
	out.push(((v >> 8) & 255) as byte);
	out.push(((v >> 16) & 255) as byte);
	out.push(((v >> 24) & 255) as byte);
}
fn get_u32(b const byte[:], o int) int { (b[o] as int) | ((b[o + 1] as int) << 8) | ((b[o + 2] as int) << 16) | ((b[o + 3] as int) << 24) }
fn kb_sig() byte[>..] {
	var b byte[>..] = [];
	put_u32(b, ENTRIES.len);
	for e in ENTRIES { put_u32(b, e.page); put_u32(b, e.off); put_u32(b, e.len); }
	let h = hash(b[..]);
	var s byte[>..] = [];
	for k in 0..8 { s.push(((h >> ((k * 8) as uint)) & 255) as byte); }
	s
}
fn save_tex() {
	var out byte[>..] = [];
	out.append("ATEXTEX1");
	let nv = VOFF.len;
	let np = PST.len;
	let texels = nv + 1 + np;
	let th = (texels + TEX_W - 1) / TEX_W;
	put_u32(out, TEX_W);
	put_u32(out, th);
	put_u32(out, nv);
	put_u32(out, np);
	out.append(kb_sig()[..]);
	for n in 0..nv { let w = word_at(n); out.push((w.len & 255) as byte); out.append(w); }
	for n in 0..nv + 1 { put_u32(out, OFFS[n]); }
	for v in PST { put_u32(out, v); }
	for k in texels..th * TEX_W { put_u32(out, 0); }
	write_file_atomic(str(ADIR, "/index.tex"), out[..]);
}
fn reset_lut() {
	clear(VOCAB);
	VARENA.clear();
	VOFF.clear();
	LASTID.clear();
	PAIRS.clear();
	OFFS.clear();
	PST.clear();
}
fn load_tex() bool {
	var b byte[>..] = [];
	if !read_file(str(ADIR, "/index.tex"), b) || b.len < 32 || b[..8] != "ATEXTEX1" { return false; }
	let nv = get_u32(b, 16);
	let np = get_u32(b, 20);
	if b[24..32] != kb_sig()[..] { return false; }
	var o = 32;
	for n in 0..nv {
		if o >= b.len { return false; }
		let l = b[o] as int;
		o += 1;
		if o + l > b.len { return false; }
		nonce_add(b[o..o + l]);
		o += l;
	}
	let pb = o + (nv + 1) * 4;
	if pb + np * 4 > b.len || VOFF.len != nv { return false; }
	OFFS.resize(nv + 1, 0);
	for n in 0..nv + 1 { OFFS[n] = get_u32(b, o + n * 4); }
	if OFFS[nv] != np { return false; }
	PST.resize(np, 0);
	for j in 0..np { PST[j] = get_u32(b, pb + j * 4); }
	true
}
fn build_grid() {
	reset_lut();
	if !load_tex() {
		reset_lut();
		for i in 0..ENTRIES.len { if ENTRIES[i].len > 0 { grid_insert(i, ekey(i), entry_text(i)); } }
		finalize_lut();
		if kb_lock(0) { save_tex(); kb_unlock(); }
	}
	GBUILT = true;
}
struct QTerm { w byte[..128], wt int, cell int, syn int }
var SN_B0 = 0;
var SN_B1 = 0;
var SN_WIN = 0;
var SN_S = 0;
var SN_E = 0;
var SN_ALSO int[>..];
var RES_ID int[>..];
var RES_S int[>..];
var RES_E int[>..];
var RES_AL int[>..];
fn lower_into(s const byte[:], out byte[>..]&) {
	out.clear();
	for c in s { out.push(lower(c)); }
}
fn code_syn(w const byte[:]) const byte[:] {
	if w == "directory" || w == "folder" { return "dir"; }
	if w == "environment" { return "env"; }
	if w == "variable" || w == "constant" { return "var"; }
	if w == "configuration" { return "config"; }
	if w == "maximum" || w == "largest" || w == "limit" { return "max"; }
	if w == "minimum" || w == "smallest" { return "min"; }
	if w == "length" || w == "size" { return "len"; }
	if w == "function" || w == "method" { return "fn"; }
	if w == "argument" || w == "parameter" { return "arg"; }
	if w == "number" { return "num"; }
	if w == "string" { return "str"; }
	if w == "message" { return "msg"; }
	if w == "error" { return "err"; }
	if w == "initialize" { return "init"; }
	if w == "repository" { return "repo"; }
	if w == "database" { return "db"; }
	if w == "temporary" { return "tmp"; }
	if w == "index" { return "idx"; }
	if w == "dimension" { return "dim"; }
	if w == "coordinate" { return "xy"; }
	if w == "temp" { return "tmp"; }
	if w == "reference" { return "ref"; }
	if w == "python" { return "py"; }
	if w == "javascript" { return "js"; }
	if w == "typescript" { return "ts"; }
	if w == "kotlin" { return "kt"; }
	if w == "rust" { return "rs"; }
	if w == "markdown" { return "md"; }
	if w == "shell" || w == "bash" { return "sh"; }
	if w == "checksum" || w == "hash" { return "sha"; }
	if w == "binary" || w == "executable" { return "bin"; }
	if w == "built" { return "build"; }
	""
}
fn add_qterm(terms QTerm[>..]&, w0 const byte[:]) {
	let w = if is_plural(w0) { w0[..w0.len - 1] } else { w0 };
	add_term_raw(terms, w, 0);
	let s = code_syn(w);
	if s.len > 0 { add_term_raw(terms, s, 1); }
	if w.len > 5 && (ends_with(w, "er") || ends_with(w, "ed")) { add_term_raw(terms, w[..w.len - 2], 1); }
	if w.len > 6 && ends_with(w, "ing") { add_term_raw(terms, w[..w.len - 3], 1); }
}
fn add_term_raw(terms QTerm[>..]&, w const byte[:], syn int) {
	if w.len < 2 || is_stop(w) { return; }
	for i in 0..terms.len { if terms[i].w[..] == w { return; } }
	var t = QTerm { wt: 0, cell: nonce_find(w), syn: syn, .. };
	t.w.append(w);
	terms.push(t);
}
fn query_terms(q const byte[:]) QTerm[>..] {
	if !GBUILT { build_grid(); }
	FUZZY_ID.clear();
	var terms QTerm[>..] = [];
	var i = 0;
	var w byte[..128] = [];
	var sub byte[..128] = [];
	var prev byte[>..] = [];
	var pr byte[>..] = [];
	while i < q.len {
		if is_tok_lead(q[i]) {
			let a = i;
			i += 1;
			while i < q.len && is_tok_cont(q[i]) { i += 1; }
			w.clear();
			var has_sep = false;
			for m in a..min(i, a + 128) {
				let lc = lower(q[m]);
				if lc == '_' || lc == '-' || lc == '.' { has_sep = true; }
				w.push(lc);
			}
			add_qterm(terms, w[..]);
			if prev.len > 0 && !is_stop(w[..]) {
				pr.clear();
				pr.append(prev[..]);
				pr.push('_');
				pr.append(w[..]);
				if nonce_find(pr[..]) >= 0 { add_term_raw(terms, pr[..], 0); }
				pr.clear();
				pr.append(prev[..]);
				pr.append(w[..]);
				if nonce_find(pr[..]) >= 0 { add_term_raw(terms, pr[..], 0); }
			}
			prev.clear();
			if !is_stop(w[..]) { prev.append(w[..]); }
			let tail = if w.len > 0 { w[w.len - 1] } else { ' ' };
			let whole = has_sep && nonce_find(w[..]) >= 0;
			if has_sep && !whole && tail != '_' && tail != '-' && tail != '.' && FUZZY_ID.len == 0 { FUZZY_ID.append(q[a..min(i, a + 128)]); }
			if has_sep && !whole {
				sub.clear();
				for m in 0..w.len {
					let c = w[m];
					if c == '_' || c == '-' || c == '.' { add_qterm(terms, sub[..]); sub.clear(); } else { sub.push(c); }
				}
				add_qterm(terms, sub[..]);
			}
		} else { i += 1; }
	}
	terms
}
fn weigh_term(terms QTerm[>..]&, ti int, n int, ids int[>..]&) int {
	ids.clear();
	postings(terms[ti].cell, ids);
	if ids.len == 0 { return 0; }
	sort(ids[..]) { a, b => a < b };
	var df = 0;
	for j in 0..ids.len { if j == 0 || ids[j] != ids[j - 1] { df += 1; } }
	let r = max(1, (n * 4) / (df + 1));
	let wt0 = (64 - clz(r as uint)) as int;
	let wt = if terms[ti].syn == 1 { max(1, wt0 / 2) } else { wt0 };
	terms[ti].wt = wt;
	wt
}
fn rank(terms QTerm[>..]&) Hit[>..] {
	if !GBUILT { build_grid(); }
	var scores = dictionary<int, int> {};
	var ids int[>..] = [];
	var total = 0;
	let n = ENTRIES.len + 1;
	for ti in 0..terms.len {
		let wt = weigh_term(terms, ti, n, ids);
		if wt == 0 { continue; }
		if terms[ti].syn == 0 { total += wt; }
		for j in 0..ids.len { if j == 0 || ids[j] != ids[j - 1] { update(scores, ids[j], 0) { it += wt; }; } }
	}
	var hits Hit[>..] = [];
	var kl byte[>..] = [];
	each(scores) { id, sc =>
		var s = sc;
		lower_into(ekey(id), kl);
		for ti in 0..terms.len { if terms[ti].wt > 0 && has_word(kl[..], stem_y(terms[ti].w[..])) { s += terms[ti].wt; } }
		if starts_with(ekey(id), "manual::") { s += 2; }
		hits.push(Hit { id: id, score: s, conf: if sc * 3 >= total { 1 } else { 0 } });
	};
	sort(hits[..]) { a, b => a.conf > b.conf || (a.conf == b.conf && (a.score > b.score || (a.score == b.score && (ENTRIES[a.id].len < ENTRIES[b.id].len || (ENTRIES[a.id].len == ENTRIES[b.id].len && a.id < b.id))))) };
	var nc = 0;
	for h in hits { if h.conf == 1 { nc += 1; } }
	let nre = min(nc, 40);
	var scr byte[>..] = [];
	for j in 0..nre {
		scr.clear();
		snippet(entry_text(hits[j].id), terms, 600, scr);
		hits[j].score = SN_WIN * 2 + hits[j].score;
	}
	sort(hits[..nre]) { a, b => a.score > b.score || (a.score == b.score && (ENTRIES[a.id].len < ENTRIES[b.id].len || (ENTRIES[a.id].len == ENTRIES[b.id].len && a.id < b.id))) };
	if nre > 0 {
		let best = hits[0].score;
		for j in 0..nre { if hits[j].score * 2 < best { hits[j].conf = 0; } }
		sort(hits[..nc]) { a, b => a.conf > b.conf || (a.conf == b.conf && (a.score > b.score || (a.score == b.score && a.id < b.id))) };
	}
	var out Hit[>..] = [];
	for h in hits {
		let hk = ekey(h.id);
		var dup = false;
		if out.len < 200 {
			for o in out {
				let ek = ekey(o.id);
				if (hk.len > ek.len && starts_with(hk, ek) && hk[ek.len] == ':') || (ek.len > hk.len && starts_with(ek, hk) && ek[hk.len] == ':') { dup = true; }
			}
		}
		if !dup { out.push(h); }
	}
	out
}
fn grid_query(q const byte[:], k int) Hit[>..] {
	var terms = query_terms(q);
	let all = rank(terms);
	var out Hit[>..] = [];
	for h in all { if out.len >= k || h.conf == 0 { break; } out.push(h); }
	out
}
fn mask_wt(terms QTerm[>..]&, m uint) int {
	var s = 0;
	for ti in 0..min(terms.len, 64) { if (m >> (ti as uint)) & 1 == 1 { s += terms[ti].wt; } }
	s
}
fn scan_lines(txt const byte[:], terms QTerm[>..]&, st int[>..]&, sc uint[>..]&, df bool[>..]&) {
	var lb byte[>..] = [];
	var a = 0;
	while a < txt.len {
		var e = a;
		while e < txt.len && txt[e] != '\n' { e += 1; }
		lower_into(txt[a..min(e, a + 2048)], lb);
		var m uint = 0;
		for ti in 0..min(terms.len, 64) { if terms[ti].wt > 0 && has_word(lb[..], stem_y(terms[ti].w[..])) { m = m | ((1 as uint) << (ti as uint)); } }
		st.push(a);
		sc.push(m);
		let tl = trim(lb[..]);
		df.push(starts_with(tl, "fn ") || starts_with(tl, "def ") || starts_with(tl, "class ") || starts_with(tl, "struct ") || starts_with(tl, "function ") || starts_with(tl, "pub fn ") || starts_with(tl, "#") || starts_with(tl, "var ") || starts_with(tl, "const ") || starts_with(tl, "let ") || starts_with(tl, "export "));
		a = e + 1;
	}
	st.push(a);
}
fn line_value(terms QTerm[>..]&, sc uint[>..]&, df bool[>..]&, j int) int {
	var wm = sc[j];
	if j > 0 { wm = wm | sc[j - 1]; }
	if j + 1 < sc.len { wm = wm | sc[j + 1]; }
	let cw = mask_wt(terms, sc[j]);
	mask_wt(terms, wm) * 4 + cw + (if df[j] { cw * 3 } else { 0 })
}
fn snippet(txt const byte[:], terms QTerm[>..]&, mc int, out byte[>..]&) int {
	var st int[>..] = [];
	var sc uint[>..] = [];
	var df bool[>..] = [];
	SN_ALSO.clear();
	scan_lines(txt, terms, st, sc, df);
	let nl = sc.len;
	if nl == 0 { SN_B0 = 0; SN_B1 = 0; SN_S = 1; SN_E = 1; return 0; }
	var b = 0;
	var bs = -1;
	for j in 0..nl {
		let v = line_value(terms, sc, df, j);
		if v > bs { bs = v; b = j; }
	}
	SN_WIN = bs;
	SN_B0 = st[b];
	SN_B1 = min(st[b + 1] - 1, txt.len);
	var s = 0;
	var e = nl - 1;
	if txt.len > mc {
		s = b;
		e = b;
		var used = st[b + 1] - st[b];
		var grow = true;
		while grow {
			grow = false;
			if e + 1 < nl && used + (st[e + 2] - st[e + 1]) <= mc { e += 1; used += st[e + 1] - st[e]; grow = true; }
			if s > 0 && used + (st[s] - st[s - 1]) <= mc { s -= 1; used += st[s + 1] - st[s]; grow = true; }
		}
	}
	SN_S = s + 1;
	SN_E = e + 1;
	var cand int[>..] = [];
	for j in 0..nl { if (j < s || j > e) && sc[j] != 0 { cand.push(j); } }
	sort(cand[..]) { x, y => mask_wt(terms, sc[x]) > mask_wt(terms, sc[y]) || (mask_wt(terms, sc[x]) == mask_wt(terms, sc[y]) && x < y) };
	for j in 0..min(cand.len, 8) { SN_ALSO.push(cand[j] + 1); }
	sort(SN_ALSO[..]) { x, y => x < y };
	out.append(" L");
	format(out, s + 1);
	out.push('-');
	format(out, e + 1);
	out.push('\n');
	let hl = out.len;
	let body = txt[st[s]..min(st[e + 1] - 1, txt.len)];
	if body.len > mc { out.append(body[..mc]); out.append("..."); } else { out.append(body); }
	if SN_ALSO.len > 0 {
		out.append("\nalso:");
		for x in SN_ALSO { out.append(" L"); format(out, x); }
		if cand.len > 8 { out.append(" (+"); format(out, cand.len - 8); out.append(")"); }
	}
	hl
}
fn flush_index() {
	var out byte[>..] = [];
	out.append("{\"schema_version\":1,\"magic\":\"ATEXKB01\",\"page_w\":");
	format(out, PAGE_W);
	out.append(",\"page_h\":");
	format(out, PAGE_H);
	out.append(",\"pages\":[");
	for i in 0..PAGES.len {
		if i > 0 { out.push(','); }
		out.append("{\"filename\":");
		json::format_string(out, PAGES[i].fname[..]);
		out.append(",\"idx\":");
		format(out, PAGES[i].idx);
		out.append(",\"used_bytes\":");
		format(out, PAGES[i].used);
		out.append(",\"created\":\"2026-11-07T00:00:00Z\"}");
	}
	out.append("],\"entries\":{");
	for i in 0..ENTRIES.len {
		if i > 0 { out.push(','); }
		json::format_key(out, ekey(i));
		out.append("{\"page_idx\":");
		format(out, ENTRIES[i].page);
		out.append(",\"offset\":");
		format(out, ENTRIES[i].off);
		out.append(",\"length\":");
		format(out, ENTRIES[i].len);
		out.append(",\"meta\":{\"source_bytes\":");
		format(out, ENTRIES[i].src_bytes);
		if ENTRIES[i].mt > 0 {
			out.append(",\"mtime\":");
			format(out, ENTRIES[i].mt);
		}
		out.append("}}");
	}
	out.append("},\"roots\":[");
	for i in 0..ROOTS.len {
		if i > 0 { out.push(','); }
		json::format_string(out, ROOTS[i][..]);
	}
	out.append("],\"n_entries\":");
	format(out, ENTRIES.len);
	out.append(",\"tokenizer\":\"utf-8_bytes\",\"created\":\"2026-11-07T00:00:00Z\"}");
	if write_file_atomic(str(ADIR, "/index.json"), out[..]) { LAST_SIG = hash(out[..]); } else { WRITE_OK = false; }
}
fn ensure_kb_dirs(dir const byte[:]) {
	if ADIR[..] != dir { ADIR.clear(); ADIR.append(dir); }
	make_dir(ADIR[..]);
	make_dir(str(ADIR, "/pages"));
	make_dir(str(ADIR, "/manual"));
}
fn load_kb(dir const byte[:]) bool {
	if ADIR[..] != dir { ADIR.clear(); ADIR.append(dir); }
	let idx_path = str(ADIR, "/index.json");
	var raw byte[>..] = [];
	if !read_file(idx_path, raw) {
		ensure_kb_dirs(dir);
		PAGES.clear();
		PDATA.clear();
		ENTRIES.clear();
		clear(KIDX);
		KARENA.clear();
		ROOTS.clear();
		PAGE_BYTES = PAGE_W * PAGE_H * 4;
		GBUILT = false;
		if kb_lock(LOCK_WAIT_MS) {
			if !file_exists(idx_path) { flush_index(); }
			kb_unlock();
		}
		return true;
	}
	if find(raw[..], "\"entries\"") < 0 {
		write_stderr("[atex] corrupt index.json\n");
		return false;
	}
	LAST_SIG = hash(raw[..]);
	var r = json::reader(raw[..]);
	PAGES.clear();
	PDATA.clear();
	ENTRIES.clear();
	clear(KIDX);
	KARENA.clear();
	ROOTS.clear();
	var scratch byte[>..] = [];
	json::each_member(r) { top_k =>
		if top_k == "page_w" { PAGE_W = json::read_number(r) as int; }
		else if top_k == "page_h" { PAGE_H = json::read_number(r) as int; }
		else if top_k == "pages" {
			json::each_element(r) {
				var fnm byte[..64] = [];
				var idx = 0;
				var ub = 0;
				json::each_member(r) { pk =>
					if pk == "filename" { fnm.append(json::read_string(r, scratch)); }
					else if pk == "idx" { idx = json::read_number(r) as int; }
					else if pk == "used_bytes" { ub = json::read_number(r) as int; }
					else { json::skip_value(r); }
				};
				PAGES.push(Page { fname: fnm, idx: idx, used: ub });
			};
		} else if top_k == "entries" {
			reserve(KIDX, 1024);
			json::each_member(r) { ek =>
				var ky byte[>..] = [];
				ky.append(ek);
				var pi = 0;
				var of = 0;
				var ln = 0;
				var sb = 0;
				var mtv = 0;
				json::each_member(r) { fk =>
					if fk == "page_idx" { pi = json::read_number(r) as int; }
					else if fk == "offset" { of = json::read_number(r) as int; }
					else if fk == "length" { ln = json::read_number(r) as int; }
					else if fk == "meta" {
						json::each_member(r) { mk =>
							if mk == "source_bytes" || mk == "parent_bytes" {
								let v = json::read_number(r) as int;
								if sb == 0 { sb = v; }
							} else if mk == "mtime" { mtv = json::read_number(r) as int; }
							else { json::skip_value(r); }
						};
					} else { json::skip_value(r); }
				};
				if sb == 0 { sb = if ln > 0 { ln } else { 2400 }; }
				let id = ENTRIES.len;
				let ko = KARENA.len;
				KARENA.append(ky[..]);
				ENTRIES.push(Entry { koff: ko, klen: ky.len, page: pi, off: of, len: ln, src_bytes: sb, mt: mtv });
				kadd(id);
			};
		} else if top_k == "roots" {
			json::each_element(r) {
				var rp byte[>..] = [];
				rp.append(json::read_string(r, scratch));
				ROOTS.push(copy(rp));
			};
		} else { json::skip_value(r); }
	};
	PAGE_BYTES = PAGE_W * PAGE_H * 4;
	GBUILT = false;
	true
}
fn valid_key(k const byte[:]) bool {
	if k.len == 0 || k.len > 256 || find(k, "..") >= 0 { return false; }
	var i = 0;
	while i < k.len {
		let c = k[i];
		let ok = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_' || c == '-' || c == '.' || c == '/' || c == ':' || c == '(' || c == ')' || c == '\'' || c == ',';
		if ok { i += 1; }
		else if i + 3 <= k.len && k[i] == 0xE2 && k[i + 1] == 0x80 && k[i + 2] == 0x94 { i += 3; }
		else { return false; }
	}
	true
}
fn lock_path() byte[>..] { str(ADIR, "/write.lock") }
fn lock_drop(dir const byte[:]) {
	delete_file(str(dir, "/owner"));
	delete_dir(dir);
}
fn lock_stale(dir const byte[:]) bool {
	let m = file_mtime(str(dir, "/owner"));
	m > 0 && time_ns() / 1000000000 - m > LOCK_STALE_S
}
fn kb_lock(wait_ms int) bool {
	if LOCK_DEPTH > 0 { LOCK_DEPTH += 1; return true; }
	let lp = lock_path();
	let mine = str(lp, ".", random_seed());
	if !make_dir(mine[..]) || !write_file(str(mine, "/owner"), "atex") { return false; }
	let t0 = clock_ns();
	var nap = 1;
	while !rename_file(mine[..], lp[..]) {
		if lock_stale(lp[..]) {
			let old = str(lp, ".", random_seed());
			if rename_file(lp[..], old[..]) {
				if lock_stale(old[..]) { lock_drop(old[..]); } else { rename_file(old[..], lp[..]); }
			}
		}
		if (clock_ns() - t0) / 1000000 >= wait_ms {
			lock_drop(mine[..]);
			return false;
		}
		sleep_ms(nap);
		nap = min(nap * 2, 50);
	}
	LOCK_DEPTH = 1;
	LOCK_BEAT = clock_ns();
	true
}
fn kb_unlock() {
	LOCK_DEPTH -= 1;
	if LOCK_DEPTH == 0 {
		let lp = lock_path();
		let old = str(lp, ".", random_seed());
		if rename_file(lp[..], old[..]) { lock_drop(old[..]); }
	}
}
fn kb_beat() {
	if LOCK_DEPTH > 0 && clock_ns() - LOCK_BEAT > 5000000000 {
		write_file(str(lock_path(), "/owner"), "atex");
		LOCK_BEAT = clock_ns();
	}
}
fn kb_refresh() bool {
	var raw byte[>..] = [];
	if !read_file(str(ADIR, "/index.json"), raw) || hash(raw[..]) == LAST_SIG { return true; }
	let d = str(ADIR);
	load_kb(d[..])
}
fn kb_begin() bool {
	let first = LOCK_DEPTH == 0;
	if !kb_lock(LOCK_WAIT_MS) {
		write_stderr("[atex] knowledge base is busy or read-only; nothing was written\n");
		return false;
	}
	if first && !kb_refresh() {
		kb_unlock();
		return false;
	}
	WRITE_OK = true;
	true
}
fn write_page(p int) {
	if !write_file_atomic(str(ADIR, "/pages/", PAGES[p].fname), PDATA[p][..]) { WRITE_OK = false; }
}
fn put_kb_entry_mem(full_key const byte[:], text const byte[:], src_b int, write_pg bool) {
	kb_beat();
	if PAGES.len == 0 {
		var pg = Page { idx: 0, used: 0, .. };
		pg.fname.append("page_000000.kb.page");
		PAGES.push(pg);
	}
	var p = PAGES.len - 1;
	ensure_page_loaded(p);
	if PAGES[p].used + text.len > PAGE_BYTES {
		if write_pg { write_page(p); }
		p = PAGES.len;
		var pg = Page { idx: p, used: 0, .. };
		format(pg.fname, "page_");
		format_int(pg.fname, p, 10, 6, '0');
		pg.fname.append(".kb.page");
		PAGES.push(pg);
		ensure_page_loaded(p);
	}
	if PDATA[p].len < PAGE_BYTES { PDATA[p].resize(PAGE_BYTES, 0); }
	let off = PAGES[p].used;
	for i in 0..text.len { PDATA[p][off + i] = text[i]; }
	PAGES[p].used += text.len;
	if write_pg { write_page(p); }
	let sb = if src_b > 0 { src_b } else { text.len };
	if (kfind(full_key) >= 0) {
		let id = kfind(full_key);
		ENTRIES[id].page = p;
		ENTRIES[id].off = off;
		ENTRIES[id].len = text.len;
		ENTRIES[id].src_bytes = sb;
		GBUILT = false;
	} else {
		let id = ENTRIES.len;
		let ko = KARENA.len;
		KARENA.append(full_key);
		ENTRIES.push(Entry { koff: ko, klen: full_key.len, page: p, off: off, len: text.len, src_bytes: sb, mt: 0 });
		kadd(id);
		if GBUILT { grid_insert(id, full_key, text); }
	}
}
fn save_kb_entry(full_key const byte[:], text const byte[:]) {
	put_kb_entry_mem(full_key, text, text.len, true);
	flush_index();
}
fn resolve_default_dir(out byte[>..]&) {
	if env("ATEX_DIR", out) && out.len > 0 { return; }
	out.clear();
	if is_dir(".atex") { out.append(".atex"); return; }
	var hm byte[>..] = [];
	if env("HOME", hm) && hm.len > 0 {
		let ai_dir = str(hm, "/ai/.atex");
		if is_dir(ai_dir) { out.append(ai_dir); return; }
		out.append(str(hm, "/.atex"));
		return;
	}
	out.append(".atex");
}
fn slugify_heading(h const byte[:], out byte[>..]&) {
	out.clear();
	var dash = false;
	for i in 0..min(h.len, 48) {
		let c = lower(h[i]);
		if (c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') {
			out.push(c);
			dash = false;
		} else if !dash && out.len > 0 {
			out.push('-');
			dash = true;
		}
	}
	while out.len > 0 && out[out.len - 1] == '-' { out.pop(); }
}
fn drop_sections(full_k const byte[:]) {
	for i in 0..ENTRIES.len {
		let k = ekey(i);
		if k.len > full_k.len + 2 && starts_with(k, full_k) && k[full_k.len] == ':' && k[full_k.len + 1] == ':' && ENTRIES[i].len > 0 {
			ENTRIES[i].len = 0;
			GBUILT = false;
		}
	}
}
fn ingest_doc(ns const byte[:], rel const byte[:], path const byte[:]) int {
	let mt = file_mtime(path);
	var raw byte[>..] = [];
	if !read_file(path, raw) || raw.len == 0 || raw.len > 524288 { return 0; }
	let full_k = str(ns, "::", rel);
	drop_sections(full_k[..]);
	put_kb_entry_mem(full_k[..], raw[..], raw.len, false);
	ENTRIES[kfind(full_k[..])].mt = mt;
	var added = 1;
	if ends_with(rel, ".md") {
		var sec_title byte[>..] = [];
		var sec_body byte[>..] = [];
		for ln in split(raw[..], '\n') {
			if starts_with(ln, "## ") || starts_with(ln, "# ") {
				if sec_title.len > 0 && sec_body.len >= 32 {
					var sl byte[>..] = [];
					slugify_heading(sec_title[..], sl);
					if sl.len > 0 {
						let sk = str(full_k, "::", sl);
						put_kb_entry_mem(sk[..], sec_body[..], raw.len, false);
						added += 1;
					}
				}
				sec_title.clear();
				let off = if starts_with(ln, "## ") { 3 } else { 2 };
				sec_title.append(trim(ln[off..]));
				sec_body.clear();
				sec_body.append(ln);
				sec_body.push('\n');
			} else if sec_title.len > 0 {
				sec_body.append(ln);
				sec_body.push('\n');
			}
		}
		if sec_title.len > 0 && sec_body.len >= 32 {
			var sl byte[>..] = [];
			slugify_heading(sec_title[..], sl);
			if sl.len > 0 {
				let sk = str(full_k, "::", sl);
				put_kb_entry_mem(sk[..], sec_body[..], raw.len, false);
				added += 1;
			}
		}
	}
	added
}
fn is_indexable_file(name const byte[:]) bool {
	ends_with(name, ".md") || ends_with(name, ".gold") || ends_with(name, ".he") || ends_with(name, ".amni") || ends_with(name, ".py") || ends_with(name, ".ts") || ends_with(name, ".rs") || ends_with(name, ".go") || ends_with(name, ".toml") || ends_with(name, ".kt") || ends_with(name, ".kts") || ends_with(name, ".js") || ends_with(name, ".java") || ends_with(name, ".swift") || ends_with(name, ".c") || ends_with(name, ".h") || ends_with(name, ".sh") || ends_with(name, ".yml") || ends_with(name, ".yaml") || ends_with(name, ".tsx") || ends_with(name, ".jsx") || ends_with(name, ".mjs") || ends_with(name, ".cjs") || ends_with(name, ".cpp") || ends_with(name, ".cc") || ends_with(name, ".hpp") || ends_with(name, ".cs") || ends_with(name, ".rb") || ends_with(name, ".php") || ends_with(name, ".lua") || ends_with(name, ".html") || ends_with(name, ".css") || ends_with(name, ".sql") || ends_with(name, ".ps1") || ends_with(name, ".bash") || ends_with(name, ".proto")
}
fn file_fresh(id int, full const byte[:]) bool {
	if id < 0 || ENTRIES[id].len == 0 || file_mtime(full) != ENTRIES[id].mt { return false; }
	if time_ns() / 1000000000 - ENTRIES[id].mt > 2 { return true; }
	var raw byte[>..] = [];
	read_file(full, raw) && raw[..] == entry_text(id)
}
fn mark_seen(id int) {
	while SW_SEEN.len <= id { SW_SEEN.push(false); }
	SW_SEEN[id] = true;
}
fn index_file(rel const byte[:], full const byte[:]) int {
	let key = str("project::", rel);
	let id = kfind(key[..]);
	if id >= 0 { mark_seen(id); }
	if file_fresh(id, full) { return 0; }
	let ph = hash(full);
	let mt = file_mtime(full);
	if contains(SW_SKIP, ph) && get(SW_SKIP, ph, 0) == mt { return 0; }
	if !SW_APPLY {
		SW_DIRTY = true;
		return 0;
	}
	let n = ingest_doc("project", rel, full);
	if n == 0 {
		insert(SW_SKIP, ph, mt);
		if id >= 0 {
			ENTRIES[id].len = 0;
			GBUILT = false;
			drop_sections(key[..]);
		}
	} else { mark_seen(kfind(key[..])); }
	n
}
fn walk_index(dir const byte[:], rel const byte[:], depth int) int {
	var names byte[>..] = [];
	if !list_dir(dir, names) { return 0; }
	var count = 0;
	for nm in split(names[..], '\n') {
		if nm.len == 0 || nm[0] == '.' || nm == "node_modules" || nm == "dist" || nm == "build" || nm == "target" || nm == "venv" || nm == "__pycache__" || nm == "vendor" { continue; }
		let full = if dir == "." { str(nm) } else { str(dir, "/", nm) };
		let r = if rel.len == 0 { str(nm) } else { str(rel, "/", nm) };
		if is_dir(full) {
			if depth < 5 { count += walk_index(full[..], r[..], depth + 1); }
		} else if is_indexable_file(nm) {
			if !(ends_with(nm, ".amni") && file_exists(str(full[..full.len - 5], ".gold"))) { count += index_file(r[..], full[..]); }
		}
	}
	count
}
fn abs_path(p const byte[:]) byte[>..] {
	if p.len > 0 && p[0] == '/' { return str(p); }
	var cwd byte[>..] = [];
	if !env("PWD", cwd) { return str(p); }
	if p.len == 0 || p == "." { return cwd; }
	str(cwd, "/", p)
}
fn add_root(path const byte[:]) {
	let full = abs_path(path);
	var hm byte[>..] = [];
	if full.len <= 1 || (env("HOME", hm) && hm[..] == full[..]) { return; }
	for r in ROOTS { if r[..] == full[..] { return; } }
	ROOTS.push(copy(full));
}
fn walk_roots() int {
	SW_SEEN.clear();
	SW_MISSING = false;
	var count = 0;
	for i in 0..ROOTS.len {
		let r = str(ROOTS[i]);
		if is_dir(r[..]) { count += walk_index(r[..], "", 1); } else { SW_MISSING = true; }
	}
	count
}
fn gone_from_root(i int) bool {
	ENTRIES[i].mt > 0 && ENTRIES[i].len > 0 && (i >= SW_SEEN.len || !SW_SEEN[i]) && starts_with(ekey(i), "project::") && !is_section(i)
}
fn apply_roots(first_page int) int {
	SW_APPLY = true;
	let count = walk_roots();
	SW_APPLY = false;
	if !SW_MISSING {
		for i in 0..ENTRIES.len {
			if gone_from_root(i) {
				let k = str(ekey(i));
				ENTRIES[i].len = 0;
				GBUILT = false;
				drop_sections(k[..]);
			}
		}
	}
	for p in first_page..PAGES.len {
		ensure_page_loaded(p);
		write_page(p);
	}
	flush_index();
	count
}
fn kb_sweep() {
	if ROOTS.len == 0 || clock_ns() - LAST_SWEEP < SW_GAP { return; }
	let t0 = clock_ns();
	SW_APPLY = false;
	SW_DIRTY = false;
	walk_roots();
	LAST_SWEEP = clock_ns();
	SW_GAP = max(500000000, (LAST_SWEEP - t0) * 20);
	if !SW_DIRTY && !SW_MISSING {
		for i in 0..ENTRIES.len {
			if gone_from_root(i) {
				SW_DIRTY = true;
				break;
			}
		}
	}
	if !SW_DIRTY || !kb_begin() { return; }
	apply_roots(max(PAGES.len - 1, 0));
	kb_unlock();
}
fn run_init(proj_dir const byte[:], kb_dir const byte[:]) {
	ensure_kb_dirs(kb_dir);
	load_kb(kb_dir);
	if !kb_begin() { return; }
	var count = 0;
	var hm byte[>..] = [];
	if env("HOME", hm) && hm.len > 0 {
		let gcl = str(hm, "/.claude/CLAUDE.md");
		if file_exists(gcl) && !file_fresh(kfind("claude::global"), gcl[..]) { count += ingest_doc("claude", "global", gcl[..]); }
	}
	add_root(proj_dir);
	count += apply_roots(0);
	kb_unlock();
	write_stdout(str("[atex init] indexed ", count, " entries (", ENTRIES.len, " total) into ", ADIR, " (gold/helium-native)\n")[..]);
	flush_stdout();
}
fn json_scan(raw const byte[:], start int, key const byte[:]) int {
	var depth = 0;
	var in_s = false;
	var i = start;
	while i < raw.len {
		let c = raw[i];
		if in_s {
			if c == '\\' { i += 2; continue; }
			if c == '"' { in_s = false; }
		} else if c == '"' {
			if key.len > 0 && depth == 1 && i + key.len <= raw.len && raw[i..i + key.len] == key { return i; }
			in_s = true;
		} else if c == '{' || c == '[' { depth += 1; }
		else if c == '}' || c == ']' {
			depth -= 1;
			if key.len == 0 && depth == 0 { return i; }
		}
		i += 1;
	}
	-1
}
fn wire_json_mcp(cfg_path const byte[:], bin_path const byte[:], kb_dir const byte[:]) bool {
	var raw byte[>..] = [];
	let exists = read_file(cfg_path, raw);
	let tpos = if exists { json_scan(raw[..], 0, "\"mcpServers\"") } else { -1 };
	if tpos >= 0 {
		let ob = find(raw[tpos..], "{");
		let oe = if ob >= 0 { json_scan(raw[..], tpos + ob, "") } else { -1 };
		if oe > 0 && json_scan(raw[tpos + ob..oe + 1], 0, "\"amnitex\"") >= 0 { return true; }
	}
	let entry = str("\"amnitex\":{\"command\":", json_str(bin_path), ",\"args\":[\"serve\",\"--atex-dir\",", json_str(kb_dir), "]}");
	var out byte[>..] = [];
	if !exists || trim(raw[..]).len == 0 {
		out.append("{\n  \"mcpServers\": {\n    ");
		out.append(entry);
		out.append("\n  }\n}\n");
	} else {
		write_file(str(cfg_path, ".atex-backup"), raw[..]);
		let pos = tpos;
		if pos >= 0 {
			let br = find(raw[pos..], "{");
			if br >= 0 {
				let ins = pos + br + 1;
				var rest = trim(raw[ins..]);
				let empty_obj = rest.len > 0 && rest[0] == '}';
				out.append(raw[..ins]);
				out.append("\n    ");
				out.append(entry);
				if !empty_obj { out.push(','); }
				out.append(raw[ins..]);
			} else { return false; }
		} else {
			let lbr = rfind(raw[..], "}");
			if lbr > 0 {
				let pre = trim(raw[..lbr]);
				out.append(raw[..lbr]);
				if pre.len > 1 && pre[pre.len - 1] != '{' && pre[pre.len - 1] != ',' { out.push(','); }
				out.append("\n  \"mcpServers\": {\n    ");
				out.append(entry);
				out.append("\n  }\n}\n");
			} else { return false; }
		}
	}
	write_file_atomic(cfg_path, out[..])
}
fn json_str(s const byte[:]) byte[>..] {
	var b byte[>..] = [];
	json::format_string(b, s);
	b
}
var NO_WINDOW = false;
fn window_key() const byte[:] { "CLAUDE_CODE_AUTO_COMPACT_WINDOW" }
fn window_val() const byte[:] { "283000" }
fn cursor_events() byte[>..][>..] {
	var e byte[>..][>..] = [];
	for n in ["sessionStart", "stop", "beforeSubmitPrompt", "preCompact", "preToolUse", "beforeReadFile", "postToolUse"] { e.push(str(n)); }
	e
}
fn je_nl(out byte[>..]&, ind int) {
	if ind >= 0 {
		out.push('\n');
		for i in 0..ind { out.append("  "); }
	}
}
fn je_emit(d json::Doc&, n int, out byte[>..]&, ind int) {
	let k = json::kind(d, n);
	if k == 5 || k == json::K_OBJ {
		out.push(if k == 5 { '[' } else { '{' });
		let deep = if ind >= 0 { ind + 1 } else { -1 };
		var any = false;
		var c = d.nodes[n].first;
		while c >= 0 {
			if any { out.push(','); }
			any = true;
			je_nl(out, deep);
			if k != 5 {
				out.append(json_str(json::name_of(d, c))[..]);
				out.append(if ind >= 0 { ": " } else { ":" });
			}
			je_emit(d, c, out, deep);
			c = d.nodes[c].next;
		}
		if any { je_nl(out, ind); }
		out.push(if k == 5 { ']' } else { '}' });
	} else if k == 4 {
		let s, _ = json::as_string(d, n);
		out.append(json_str(s)[..]);
	} else if k == 2 { out.append(str(d.nodes[n].whole)[..]); }
	else if k == 3 { json::format_number(out, d.nodes[n].num); }
	else if k == 1 { out.append(if d.nodes[n].whole == 1 { "true" } else { "false" }); }
	else { out.append("null"); }
}
fn is_atex_hook(cmd const byte[:]) bool { find(cmd, "atex-cursor") >= 0 || (find(cmd, "atex") >= 0 && (find(cmd, " hook stop") >= 0 || find(cmd, " hook start") >= 0 || find(cmd, " hook tool") >= 0)) }
fn hooks_merged(d json::Doc&, hn int, rows const byte[>..][:]) byte[>..] {
	var o = str("{");
	var any = false;
	var done bool[>..] = [];
	for i in 0..rows.len { done.push(false); }
	var c = if hn >= 0 { d.nodes[hn].first } else { -1 };
	while c >= 0 {
		let evn = json::name_of(d, c);
		var arr = str("[");
		var n = 0;
		var g = if json::kind(d, c) == 5 { d.nodes[c].first } else { -1 };
		while g >= 0 {
			let own, oko = json::as_string(d, json::member(d, g, "command"));
			let hs = json::member(d, g, "hooks");
			var kept = str("[");
			var nk = 0;
			var dropped = 0;
			var h = if hs >= 0 { d.nodes[hs].first } else { -1 };
			while h >= 0 {
				let cmd, _ = json::as_string(d, json::member(d, h, "command"));
				if is_atex_hook(cmd) { dropped += 1; } else {
					if nk > 0 { kept.push(','); }
					je_emit(d, h, kept, -1);
					nk += 1;
				}
				h = d.nodes[h].next;
			}
			kept.push(']');
			if !(oko && is_atex_hook(own)) {
				if dropped == 0 {
					if n > 0 { arr.push(','); }
					je_emit(d, g, arr, -1);
					n += 1;
				} else if nk > 0 {
					if n > 0 { arr.push(','); }
					arr.push('{');
					var m = d.nodes[g].first;
					var sep = false;
					while m >= 0 {
						if sep { arr.push(','); }
						sep = true;
						arr.append(json_str(json::name_of(d, m))[..]);
						arr.push(':');
						if json::name_of(d, m) == "hooks" { arr.append(kept[..]); } else { je_emit(d, m, arr, -1); }
						m = d.nodes[m].next;
					}
					arr.push('}');
					n += 1;
				}
			}
			g = d.nodes[g].next;
		}
		var i = 0;
		while i < rows.len {
			if rows[i][..] == evn {
				if n > 0 { arr.push(','); }
				arr.append(rows[i + 1][..]);
				n += 1;
				done[i] = true;
			}
			i += 2;
		}
		arr.push(']');
		if n > 0 {
			if any { o.push(','); }
			any = true;
			o.append(json_str(evn)[..]);
			o.push(':');
			o.append(arr[..]);
		}
		c = d.nodes[c].next;
	}
	var i = 0;
	while i < rows.len {
		if !done[i] {
			var arr = str("[");
			var n = 0;
			var j = i;
			while j < rows.len {
				if rows[j][..] == rows[i][..] {
					if n > 0 { arr.push(','); }
					arr.append(rows[j + 1][..]);
					n += 1;
					done[j] = true;
				}
				j += 2;
			}
			arr.push(']');
			if any { o.push(','); }
			any = true;
			o.append(json_str(rows[i][..])[..]);
			o.push(':');
			o.append(arr[..]);
		}
		i += 2;
	}
	o.push('}');
	o
}
fn env_merged(d json::Doc&, en int, add_window bool) byte[>..] {
	var o = str("{");
	var any = false;
	var has = false;
	var c = if en >= 0 { d.nodes[en].first } else { -1 };
	while c >= 0 {
		let v, _ = json::as_string(d, c);
		let mine = json::name_of(d, c) == window_key();
		has = has || mine;
		if !(mine && !add_window && v == window_val()) {
			if any { o.push(','); }
			any = true;
			o.append(json_str(json::name_of(d, c))[..]);
			o.push(':');
			je_emit(d, c, o, -1);
		}
		c = d.nodes[c].next;
	}
	if add_window && !has {
		if any { o.push(','); }
		o.append(str(json_str(window_key()), ":", json_str(window_val()))[..]);
	}
	o.push('}');
	o
}
fn save_json(path const byte[:], exists bool, raw const byte[:], d json::Doc&, root int, compact const byte[:]) int {
	var nd = json::Doc {};
	let nr, _ = json::parse(compact, nd);
	if nr < 0 { return -1; }
	var neu byte[>..] = [];
	je_emit(nd, nr, neu, 0);
	neu.push('\n');
	var old byte[>..] = [];
	je_emit(d, root, old, 0);
	old.push('\n');
	if exists && neu == old { return 0; }
	if exists && !file_exists(str(path, ".atex-backup")) { write_file(str(path, ".atex-backup"), raw); }
	if write_file_atomic(path, neu[..]) { 1 } else { -1 }
}
fn hooks_update(path const byte[:], rows const byte[>..][:], add_window bool, seed const byte[:]) int {
	var raw byte[>..] = [];
	let exists = read_file(path, raw);
	var d = json::Doc {};
	let t = trim(raw[..]);
	let root, _ = json::parse(if t.len > 0 { t } else { seed }, d);
	if root < 0 || json::kind(d, root) != json::K_OBJ { return -1; }
	var o = str("{");
	var any = false;
	var saw_h = false;
	var saw_e = false;
	var c = d.nodes[root].first;
	while c >= 0 {
		let nm = json::name_of(d, c);
		var val byte[>..] = [];
		if nm == "hooks" {
			saw_h = true;
			val = hooks_merged(d, c, rows);
		} else if nm == "env" {
			saw_e = true;
			val = env_merged(d, c, add_window);
		} else { je_emit(d, c, val, -1); }
		if !((nm == "hooks" || nm == "env") && val == "{}") {
			if any { o.push(','); }
			any = true;
			o.append(json_str(nm)[..]);
			o.push(':');
			o.append(val[..]);
		}
		c = d.nodes[c].next;
	}
	if !saw_h && rows.len > 0 {
		if any { o.push(','); }
		any = true;
		o.append("\"hooks\":");
		o.append(hooks_merged(d, -1, rows)[..]);
	}
	if !saw_e && add_window {
		if any { o.push(','); }
		o.append("\"env\":");
		o.append(env_merged(d, -1, true)[..]);
	}
	o.push('}');
	save_json(path, exists, raw[..], d, root, o[..])
}
fn claude_rows(bin_path const byte[:], kb_dir const byte[:]) byte[>..][>..] {
	var rows byte[>..][>..] = [];
	var q byte[>..] = [];
	sh_quote(q, bin_path);
	var kq byte[>..] = [];
	sh_quote(kq, kb_dir);
	for ev in ["Stop", "SessionStart", "PostToolUse"] {
		let kind = if ev == "Stop" { "stop" } else if ev == "SessionStart" { "start" } else { "tool" };
		let ma = if ev == "SessionStart" { "\"matcher\":\"clear|compact\"," } else if ev == "PostToolUse" { "\"matcher\":\"Bash\"," } else { "" };
		rows.push(str(ev));
		rows.push(str("{", ma, "\"hooks\":[{\"type\":\"command\",\"command\":", json_str(str(q, " hook ", kind, " --atex-dir ", kq)[..]), "}]}"));
	}
	rows
}
fn cursor_rule() const byte[:] { "---\ndescription: Keep Cursor prompts small with AmniTex\nalwaysApply: true\n---\n\nDo not reread a whole file or paste a whole tool log. Use atex_where to find the file, then atex_recall with query or lines. A large or repeated read is replaced by a short excerpt before it reaches the model.\n" }
fn wire_cursor(hm const byte[:], bin_path const byte[:], kb_dir const byte[:]) {
	make_dir(str(hm, "/.cursor/hooks"));
	make_dir(str(hm, "/.cursor/rules"));
	let script = str(hm, "/.cursor/hooks/atex-cursor");
	var q byte[>..] = [];
	sh_quote(q, bin_path);
	var kq byte[>..] = [];
	sh_quote(kq, kb_dir);
	write_file(script, str("#!/bin/sh\nexec ", q, " hook cursor --atex-dir ", kq, "\n")[..]);
	var sq byte[>..] = [];
	sh_quote(sq, script[..]);
	run_command(str("chmod 755 ", sq)[..]);
	var rows byte[>..][>..] = [];
	for ev in cursor_events() {
		rows.push(copy(ev));
		rows.push(str("{\"command\":", json_str(script[..]), "}"));
	}
	let r = hooks_update(str(hm, "/.cursor/hooks.json")[..], rows[..], false, "{\"version\":1}");
	write_stdout(if r < 0 { "  ! ~/.cursor/hooks.json is not valid JSON; left unchanged\n" } else { "  + Cursor hooks (~/.cursor/hooks.json)\n" });
	write_file(str(hm, "/.cursor/rules/amnitex.mdc"), cursor_rule());
}
fn mcp_drop(path const byte[:]) bool {
	var raw byte[>..] = [];
	if !read_file(path, raw) { return false; }
	var d = json::Doc {};
	let root, _ = json::parse(trim(raw[..]), d);
	if root < 0 { return false; }
	let srv = json::member(d, root, "mcpServers");
	if json::member(d, srv, "amnitex") < 0 { return false; }
	var o = str("{");
	var any = false;
	var c = d.nodes[root].first;
	while c >= 0 {
		if any { o.push(','); }
		any = true;
		o.append(json_str(json::name_of(d, c))[..]);
		o.push(':');
		if c == srv {
			o.push('{');
			var m = d.nodes[srv].first;
			var sep = false;
			while m >= 0 {
				if json::name_of(d, m) != "amnitex" {
					if sep { o.push(','); }
					sep = true;
					o.append(json_str(json::name_of(d, m))[..]);
					o.push(':');
					je_emit(d, m, o, -1);
				}
				m = d.nodes[m].next;
			}
			o.push('}');
		} else { je_emit(d, c, o, -1); }
		c = d.nodes[c].next;
	}
	o.push('}');
	save_json(path, true, raw[..], d, root, o[..]) > 0
}
fn toml_drop(path const byte[:]) bool {
	var raw byte[>..] = [];
	if !read_file(path, raw) { return false; }
	let at = find(raw[..], "[mcp_servers.amnitex]");
	if at < 0 { return false; }
	let nx = find(raw[at + 1..], "\n[");
	let start = if at > 0 && raw[at - 1] == '\n' { at - 1 } else { at };
	var o = str(raw[..start]);
	if nx >= 0 { o.append(raw[at + 1 + nx..]); }
	if !file_exists(str(path, ".atex-backup")) { write_file(str(path, ".atex-backup"), raw[..]); }
	write_file_atomic(path, o[..])
}
fn run_uninstall() {
	var hm byte[>..] = [];
	if !env("HOME", hm) || hm.len == 0 { write_stderr("[atex uninstall] HOME is not set\n"); exit(1); }
	var none byte[>..][>..] = [];
	if file_exists(str(hm, "/.claude/settings.json")) && hooks_update(str(hm, "/.claude/settings.json")[..], none[..], false, "{}") > 0 { write_stdout("  - Claude Code hooks and compact setting\n"); }
	if file_exists(str(hm, "/.cursor/hooks.json")) && hooks_update(str(hm, "/.cursor/hooks.json")[..], none[..], false, "{}") > 0 { write_stdout("  - Cursor hooks\n"); }
	for f in ["/.cursor/hooks/atex-cursor", "/.cursor/rules/amnitex.mdc"] { if delete_file(str(hm, f)) { write_stdout(str("  - ~", f, "\n")[..]); } }
	for f in ["/.claude.json", "/.cursor/mcp.json", "/.codeium/windsurf/mcp_config.json", "/.gemini/settings.json", "/.config/Claude/claude_desktop_config.json", "/Library/Application Support/Claude/claude_desktop_config.json"] { if mcp_drop(str(hm, f)[..]) { write_stdout(str("  - MCP server from ~", f, "\n")[..]); } }
	for f in ["/.codex/config.toml", "/.grok/config.toml"] { if toml_drop(str(hm, f)[..]) { write_stdout(str("  - MCP server from ~", f, "\n")[..]); } }
	write_stdout("[atex uninstall] done. Knowledge bases were left in place. Backups end in .atex-backup.\n");
	flush_stdout();
}
fn doctor_row(ok bool, text const byte[:], fails int&) {
	write_stdout(str(if ok { "ok " } else { "missing " }, text, "\n")[..]);
	if !ok { fails += 1; }
}
fn hook_kb(raw const byte[:]) byte[>..] {
	let at = find(raw, " hook stop --atex-dir '");
	if at < 0 { return str(""); }
	let s = at + 23;
	let e = find(raw[s..], "'");
	if e < 0 { str("") } else { str(raw[s..s + e]) }
}
fn run_doctor() {
	var hm byte[>..] = [];
	env("HOME", hm);
	var fails = 0;
	write_stdout("atex 0.4.0 (gold/helium-native)\n");
	if is_dir(str(hm, "/.claude")) {
		var raw byte[>..] = [];
		read_file(str(hm, "/.claude/settings.json"), raw);
		var d = json::Doc {};
		let root, _ = json::parse(trim(raw[..]), d);
		doctor_row(root >= 0, "Claude Code settings.json is readable", fails);
		doctor_row(find(raw[..], " hook stop") >= 0, "hook that saves each turn", fails);
		doctor_row(find(raw[..], " hook start") >= 0, "hook that restores state after /clear and compaction", fails);
		doctor_row(find(raw[..], " hook tool") >= 0, "hook that keeps long Bash output on disk", fails);
		let w, okw = json::as_string(d, json::member(d, json::member(d, root, "env"), window_key()));
		write_stdout(if okw { str("ok compact window ", w, " (compacts about 33K tokens earlier)\n") } else { str("off compaction setting; Claude Code uses its default\n") });
		var cj byte[>..] = [];
		read_file(str(hm, "/.claude.json"), cj);
		var dj = json::Doc {};
		let rj, _ = json::parse(trim(cj[..]), dj);
		let srv = json::member(dj, json::member(dj, rj, "mcpServers"), "amnitex");
		doctor_row(srv >= 0, "Claude Code MCP server", fails);
		let args = json::member(dj, srv, "args");
		let mk, okm = json::as_string(dj, json::element(dj, args, json::count(dj, args) - 1));
		let hk = hook_kb(raw[..]);
		if okm && hk.len > 0 { doctor_row(mk == hk[..], str("one knowledge base for hooks and search (hooks ", hk, ", search ", mk, ")")[..], fails); }
	}
	if is_dir(str(hm, "/.cursor")) {
		let script = str(hm, "/.cursor/hooks/atex-cursor");
		doctor_row(file_exists(script), "Cursor hook script", fails);
		var hj byte[>..] = [];
		read_file(str(hm, "/.cursor/hooks.json"), hj);
		var hd = json::Doc {};
		let hr, _ = json::parse(trim(hj[..]), hd);
		let evs = json::member(hd, hr, "hooks");
		for ev in cursor_events() {
			var found = false;
			var g = if json::kind(hd, json::member(hd, evs, ev[..])) == 5 { hd.nodes[json::member(hd, evs, ev[..])].first } else { -1 };
			while g >= 0 {
				let c, _ = json::as_string(hd, json::member(hd, g, "command"));
				found = found || find(c, "atex-cursor") >= 0;
				g = hd.nodes[g].next;
			}
			doctor_row(found, str("Cursor hook ", ev)[..], fails);
		}
		doctor_row(file_exists(str(hm, "/.cursor/rules/amnitex.mdc")), "Cursor rule", fails);
		var cm byte[>..] = [];
		read_file(str(hm, "/.cursor/mcp.json"), cm);
		doctor_row(find(cm[..], "amnitex") >= 0, "Cursor MCP server", fails);
	}
	write_stdout(if fails == 0 { "doctor ok\n" } else { "doctor fail: run atex install\n" });
	flush_stdout();
	exit(if fails == 0 { 0 } else { 1 });
}
fn env_int(name const byte[:], dflt int) int {
	var v byte[>..] = [];
	if !env(name, v) || v.len == 0 { return dflt; }
	var n = 0;
	for c in v {
		if c < '0' || c > '9' { return dflt; }
		n = n * 10 + (c - '0') as int;
	}
	n
}
fn utf8_floor(s const byte[:], at0 int) int {
	var at = at0;
	while at > 0 && at < s.len && (s[at] & 0xC0) == 0x80 { at -= 1; }
	at
}
fn count_lines(s const byte[:]) int {
	var n = 0;
	for c in s { if c == '\n' { n += 1; } }
	if s.len > 0 && s[s.len - 1] != '\n' { n += 1; }
	n
}
fn has_signal(ln const byte[:], low byte[>..]&) bool {
	low.clear();
	lower_into(ln[..min(ln.len, 400)], low);
	for w in ["error", "fail", "fatal", "panic", "exception", "traceback", "warning"] { if find(low[..], w) >= 0 { return true; } }
	false
}
fn excerpt_output(s const byte[:], budget int, path const byte[:]) byte[>..] {
	if s.len <= budget { return str(s); }
	let part = budget * 2 / 5;
	var hd = part;
	while hd > 0 && s[hd - 1] != '\n' { hd -= 1; }
	if hd == 0 { hd = utf8_floor(s, part); }
	var tl = s.len - part;
	while tl < s.len && s[tl] != '\n' { tl += 1; }
	tl = if tl + 1 >= s.len { utf8_floor(s, s.len - part) } else { tl + 1 };
	var mid byte[>..] = [];
	var low byte[>..] = [];
	var room = budget - 2 * part;
	var kept = 0;
	for ln in split(s[hd..tl], '\n') {
		if room <= 0 { break; }
		if ln.len > 0 && has_signal(ln, low) {
			let cut = utf8_floor(ln, min(ln.len, 200));
			mid.append(ln[..cut]);
			mid.push('\n');
			room -= cut + 1;
			kept += 1;
		}
	}
	var o = str(s[..hd]);
	if o.len > 0 && o[o.len - 1] != '\n' { o.push('\n'); }
	o.append(str("[atex: showing ", count_lines(s[..hd]) + kept + count_lines(s[tl..]), " of ", count_lines(s), " lines. Full output: ", path, " Search it with rg or print a range with sed -n.]\n")[..]);
	o.append(mid[..]);
	o.append(s[tl..]);
	o
}
fn hook_tool(kb_dir const byte[:]) {
	var inp byte[>..] = [];
	read_stdin(inp);
	let cap = env_int("ATEX_TOOL_CAP", 4200);
	if cap == 0 || inp.len <= cap { return; }
	var d = json::Doc {};
	let root, _ = json::parse(trim(inp[..]), d);
	if root < 0 { return; }
	let tn, _ = json::as_string(d, json::member(d, root, "tool_name"));
	if tn != "Bash" { return; }
	let cmd, _ = json::as_string(d, json::member(d, json::member(d, root, "tool_input"), "command"));
	if find(cmd, "/atex-") >= 0 && find(cmd, ".txt") >= 0 { return; }
	let resp = json::member(d, root, "tool_response");
	let so, oko = json::as_string(d, json::member(d, resp, "stdout"));
	let se, _ = json::as_string(d, json::member(d, resp, "stderr"));
	let img, _ = json::as_bool(d, json::member(d, resp, "isImage"));
	if !oko || img || so.len + se.len <= cap { return; }
	let tp, okt = json::as_string(d, json::member(d, root, "transcript_path"));
	let sid, oks = json::as_string(d, json::member(d, root, "session_id"));
	let tid, _ = json::as_string(d, json::member(d, root, "tool_use_id"));
	let slash = rfind(tp, "/");
	var dir byte[>..] = [];
	if okt && oks && slash > 0 && sid.len > 0 && find(sid, "/") < 0 {
		make_dir(str(tp[..slash], "/", sid));
		dir = str(tp[..slash], "/", sid, "/tool-results");
	} else { dir = str(kb_dir, "/out"); }
	make_dir(dir[..]);
	var safe byte[>..] = [];
	for c in tid { if (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_' || c == '-' { safe.push(c); } }
	if safe.len == 0 { safe = str(time_ns()); }
	var path = str(dir, "/atex-", safe, ".txt");
	var full = str(so);
	if se.len > 0 {
		if full.len > 0 { full.append("\n--- stderr ---\n"); }
		full.append(se);
	}
	if !write_file(path[..], full[..]) {
		make_dir(kb_dir);
		make_dir(str(kb_dir, "/out"));
		path = str(kb_dir, "/out/atex-", safe, ".txt");
		if !write_file(path[..], full[..]) { return; }
	}
	let be = if se.len == 0 { 0 } else { min(se.len, max(cap / 3, cap - so.len)) };
	let xo = excerpt_output(so, cap - be, path[..]);
	let xe = excerpt_output(se, be, path[..]);
	var o = str("{\"hookSpecificOutput\":{\"hookEventName\":\"PostToolUse\",\"updatedToolOutput\":{");
	var any = false;
	var c = d.nodes[resp].first;
	while c >= 0 {
		let nm = json::name_of(d, c);
		if any { o.push(','); }
		any = true;
		o.append(json_str(nm)[..]);
		o.push(':');
		if nm == "stdout" { o.append(json_str(xo[..])[..]); }
		else if nm == "stderr" { o.append(json_str(xe[..])[..]); }
		else { je_emit(d, c, o, -1); }
		c = d.nodes[c].next;
	}
	o.append("}}}\n");
	write_stdout(o[..]);
	flush_stdout();
}
fn run_install(bin_arg const byte[:], kb_dir const byte[:]) {
	ensure_kb_dirs(kb_dir);
	load_kb(kb_dir);
	var hm byte[>..] = [];
	env("HOME", hm);
	var rd byte[>..] = [];
	let bin_path = if resource_dir(rd) && rd.len > 0 && file_exists(str(rd, "/atex")) { str(rd, "/atex") } else if file_exists(str(hm, "/.local/bin/atex")) { str(hm, "/.local/bin/atex") } else { str(bin_arg) };
	var wired = 0;
	if hm.len > 0 {
		if wire_json_mcp(str(hm, "/.claude.json")[..], bin_path[..], kb_dir) {
			write_stdout("  + wired Claude Code (~/.claude.json)\n");
			wired += 1;
		}
		if is_dir(str(hm, "/.claude")) {
			let rows = claude_rows(bin_path[..], kb_dir);
			let hr = hooks_update(str(hm, "/.claude/settings.json")[..], rows[..], !NO_WINDOW, "{}");
			write_stdout(if hr < 0 { "  ! ~/.claude/settings.json is not valid JSON; left unchanged\n" } else { "  + Claude Code hooks (saves turns, restores state after /clear and compaction, keeps long Bash output on disk)\n" });
			if hr >= 0 && !NO_WINDOW { write_stdout(str("  + Claude Code compacts at about 250K tokens (", window_key(), "=", window_val(), ") unless you already set that. To turn this off: atex install --no-compact-window\n")[..]); }
		}
		if is_dir(str(hm, "/.cursor")) { wire_cursor(hm[..], bin_path[..], kb_dir); }
		if is_dir(str(hm, "/.cursor")) && wire_json_mcp(str(hm, "/.cursor/mcp.json")[..], bin_path[..], kb_dir) {
			write_stdout("  + wired Cursor (~/.cursor/mcp.json)\n");
			wired += 1;
		}
		if is_dir(str(hm, "/.codeium/windsurf")) || is_dir(str(hm, "/.codeium")) {
			make_dir(str(hm, "/.codeium/windsurf"));
			if wire_json_mcp(str(hm, "/.codeium/windsurf/mcp_config.json")[..], bin_path[..], kb_dir) {
				write_stdout("  + wired Windsurf (~/.codeium/windsurf/mcp_config.json)\n");
				wired += 1;
			}
		}
		if is_dir(str(hm, "/.gemini")) {
			make_dir(str(hm, "/.gemini"));
			if wire_json_mcp(str(hm, "/.gemini/settings.json")[..], bin_path[..], kb_dir) {
				write_stdout("  + wired Gemini CLI (~/.gemini/settings.json)\n");
				wired += 1;
			}
		}
		if is_dir(str(hm, "/.config/Claude")) {
			if wire_json_mcp(str(hm, "/.config/Claude/claude_desktop_config.json")[..], bin_path[..], kb_dir) {
				write_stdout("  + wired Claude Desktop (~/.config/Claude/claude_desktop_config.json)\n");
				wired += 1;
			}
		}
		if is_dir(str(hm, "/Library/Application Support/Claude")) {
			if wire_json_mcp(str(hm, "/Library/Application Support/Claude/claude_desktop_config.json")[..], bin_path[..], kb_dir) {
				write_stdout("  + wired Claude Desktop (macOS Application Support)\n");
				wired += 1;
			}
		}
		if is_dir(str(hm, "/.codex")) {
			let cx = str(hm, "/.codex/config.toml");
			var raw byte[>..] = [];
			read_file(cx, raw);
			if find(raw[..], "mcp_servers.amnitex") < 0 {
				let blk = str("\n[mcp_servers.amnitex]\ncommand = ", json_str(bin_path[..]), "\nargs = [\"serve\", \"--atex-dir\", ", json_str(kb_dir), "]\n");
				append_file(cx, blk[..]);
			}
			write_stdout("  + wired OpenAI Codex (~/.codex/config.toml)\n");
			wired += 1;
		}
		if is_dir(str(hm, "/.grok")) {
			let gx = str(hm, "/.grok/config.toml");
			var graw byte[>..] = [];
			read_file(gx, graw);
			if find(graw[..], "mcp_servers.amnitex") < 0 {
				let gblk = str("\n[mcp_servers.amnitex]\ncommand = ", json_str(bin_path[..]), "\nargs = [\"serve\", \"--atex-dir\", ", json_str(kb_dir), "]\n");
				append_file(gx, gblk[..]);
			}
			write_stdout("  + wired Grok Build (~/.grok/config.toml)\n");
			wired += 1;
		}
	}
	write_stdout(str("[atex install] wired ", wired, " AI clients -> ", bin_path, " (kb=", kb_dir, ")\n")[..]);
	flush_stdout();
}
fn sh_quote(out byte[>..]&, v const byte[:]) {
	out.push('\'');
	for c in v {
		if c == '\'' { out.append("'\\''"); } else { out.push(c); }
	}
	out.push('\'');
}
fn run_selftest() int {
	var tmp byte[>..] = [];
	if !env("TMPDIR", tmp) || tmp.len == 0 { tmp.clear(); tmp.append("/tmp"); }
	let tdir = str(tmp, "/atex-selftest-", random_seed());
	ensure_kb_dirs(tdir[..]);
	load_kb(tdir[..]);
	save_kb_entry("manual::probe_fact", "PORT_9471_UDP is the primary telemetry port for AmniTex Helium.");
	let hits = grid_query("telemetry udp port", 3);
	let ok = hits.len > 0 && ekey(hits[0].id) == "manual::probe_fact" && find(entry_text(hits[0].id), "PORT_9471_UDP") >= 0;
	save_kb_entry("manual::probe_fact", "Replacement giraffe text.");
	let renewed = find(search_text("giraffe", 3, 600, 1)[..], "Replacement giraffe") >= 0 && find(search_text("telemetry", 3, 600, 1)[..], "no stored entry") >= 0;
	var self_path byte[>..] = [];
	arg(0, self_path);
	var cmd byte[>..] = [];
	let writers = 8;
	for i in 0..writers {
		cmd.append("printf '%s\\n' '{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"tools/call\",\"params\":{\"name\":\"atex_remember\",\"arguments\":{\"key\":\"writer_");
		format(cmd, i);
		cmd.append("\",\"text\":\"writer fact ");
		format(cmd, i);
		cmd.append("\"}}}' | ");
		sh_quote(cmd, self_path[..]);
		cmd.append(" serve --atex-dir ");
		sh_quote(cmd, tdir[..]);
		cmd.append(" >/dev/null 2>&1 &\n");
	}
	cmd.append("wait\n");
	run_command(cmd[..]);
	load_kb(tdir[..]);
	var intact = 0;
	for i in 0..writers {
		let id = kfind(str("manual::writer_", i)[..]);
		if id >= 0 && entry_text(id) == str("writer fact ", i)[..] { intact += 1; }
	}
	let unlocked = !is_dir(lock_path()[..]);
	let src = str(tdir, "/src");
	let src_file = str(src, "/tier.py");
	make_dir(src[..]);
	write_file(src_file[..], "alpha\nORIGINAL_VALUE here\nomega\n");
	kb_begin();
	add_root(src[..]);
	apply_roots(0);
	kb_unlock();
	let w_old = where_text("ORIGINAL_VALUE", 3, "");
	let in_file = file_query_text("project::tier.py", entry_text(kfind("project::tier.py")), "ORIGINAL_VALUE", 600);
	var tiers = find(w_old[..], "project::tier.py 1: L2") >= 0 && find(in_file[..], "ORIGINAL_VALUE") >= 0;
	write_file(src_file[..], "alpha\nCHANGED_VALUE here\nomega\n");
	LAST_SWEEP = 0;
	kb_sweep();
	tiers = tiers && find(where_text("CHANGED_VALUE", 3, "")[..], "project::tier.py") >= 0 && find(where_text("ORIGINAL_VALUE", 3, "")[..], "no exact match") >= 0;
	delete_file(src_file[..]);
	LAST_SWEEP = 0;
	kb_sweep();
	tiers = tiers && find(where_text("CHANGED_VALUE", 3, "")[..], "project::tier.py") < 0;
	var rm byte[>..] = [];
	rm.append("rm -rf ");
	sh_quote(rm, tdir[..]);
	run_command(rm[..]);
	if ok && renewed && intact == writers && unlocked && tiers {
		write_stdout(str("[atex selftest] PASS (gold/helium-native, recall=1/1, exact_match=true, concurrent=", intact, "/", writers, ", tiers=true)\n")[..]);
		flush_stdout();
		0
	} else {
		write_stderr(str("[atex selftest] FAIL recall=", ok, " overwrite=", renewed, " concurrent=", intact, "/", writers, " unlocked=", unlocked, " tiers=", tiers, "\n")[..]);
		1
	}
}
fn write_id(out byte[>..]&, d json::Doc&, id_node int) {
	out.append("\"id\":");
	if id_node < 0 { out.append("null"); } else { json::format_node(out, d, id_node); }
}
fn send_ok_text(d json::Doc&, id_node int, text const byte[:], is_err bool) {
	var out byte[>..] = [];
	out.append("{\"jsonrpc\":\"2.0\",");
	write_id(out, d, id_node);
	out.append(",\"result\":{\"content\":[{\"type\":\"text\",\"text\":");
	json::format_string(out, text);
	out.append("}],\"isError\":");
	out.append(if is_err { "true" } else { "false" });
	out.append("}}\n");
	write_stdout(out[..]);
	flush_stdout();
}
fn send_err(d json::Doc&, id_node int, code int, msg const byte[:]) {
	var out byte[>..] = [];
	out.append("{\"jsonrpc\":\"2.0\",");
	write_id(out, d, id_node);
	out.append(",\"error\":{\"code\":");
	format(out, code);
	out.append(",\"message\":");
	json::format_string(out, msg);
	out.append("}}\n");
	write_stdout(out[..]);
	flush_stdout();
}
fn format_stats_line() byte[>..] {
	var used = 0;
	for pg in PAGES { used += pg.used; }
	let cap = PAGES.len * PAGE_BYTES;
	let util = if cap > 0 { (used as real / cap as real) * 100.0 } else { 0.0 };
	str("entries=", ENTRIES.len, " pages=", PAGES.len, " used=", fmt(used as real / 1000000.0, 2), "MB capacity=", fmt(cap as real / 1000000.0, 2), "MB fill=", fmt(util, 1), "% engine=gold/helium-native")
}
fn proj_slug(cwd const byte[:]) byte[>..] {
	var sl byte[>..] = [];
	slugify_heading(cwd[max(0, cwd.len - 48)..], sl);
	if sl.len == 0 { sl.append("root"); }
	sl
}
fn clip(out byte[>..]&, s const byte[:], n int) {
	if s.len > n { out.append(s[..n]); out.append(" [...]"); } else { out.append(s); }
}
fn hook_stop(d json::Doc&, root int) {
	if kb_begin() {
		save_turn(d, root);
		kb_unlock();
	}
}
fn save_turn(d json::Doc&, root int) {
	let tp, okt = json::as_string(d, json::member(d, root, "transcript_path"));
	let cwd, _ = json::as_string(d, json::member(d, root, "cwd"));
	if !okt { return; }
	var raw byte[>..] = [];
	if !read_file(tp, raw) { return; }
	var prompt byte[>..] = [];
	var reply byte[>..] = [];
	var tools byte[>..] = [];
	var files byte[>..][>..] = [];
	var ld = json::Doc {};
	for ln in split(raw[..], '\n') {
		let isu = find(ln, "\"type\":\"user\"") >= 0 || find(ln, "\"type\": \"user\"") >= 0;
		let isa = find(ln, "\"type\":\"assistant\"") >= 0 || find(ln, "\"type\": \"assistant\"") >= 0;
		if !isu && !isa { continue; }
		let r, _ = json::parse(ln, ld);
		if r < 0 { continue; }
		let sc, oks = json::as_bool(ld, json::member(ld, r, "isSidechain"));
		let mt, okm = json::as_bool(ld, json::member(ld, r, "isMeta"));
		if (oks && sc) || (okm && mt) { continue; }
		let ty, _ = json::as_string(ld, json::member(ld, r, "type"));
		let ct = json::member(ld, json::member(ld, r, "message"), "content");
		if ty == "user" {
			var txt byte[>..] = [];
			var tool_res = false;
			let s, isstr = json::as_string(ld, ct);
			if isstr { txt.append(s); } else {
				for i in 0..json::count(ld, ct) {
					let it = json::element(ld, ct, i);
					let bt, _ = json::as_string(ld, json::member(ld, it, "type"));
					if bt == "tool_result" {
						tool_res = true;
						let c1, okc = json::as_string(ld, json::member(ld, it, "content"));
						if okc && c1.len > 0 {
							if tools.len > 0 { tools.push('\n'); }
							tools.append(c1);
						}
					}
					else if bt == "text" { let tx, _ = json::as_string(ld, json::member(ld, it, "text")); if txt.len > 0 { txt.push('\n'); } txt.append(tx); }
				}
			}
			let tt = trim(txt[..]);
			if !tool_res && tt.len > 0 && !starts_with(tt, "<command") && !starts_with(tt, "<local-command") && !starts_with(tt, "Caveat:") && !starts_with(tt, "<system-reminder") {
				prompt.clear();
				prompt.append(tt);
				reply.clear();
				tools.clear();
			}
		} else {
			for i in 0..json::count(ld, ct) {
				let it = json::element(ld, ct, i);
				let bt, _ = json::as_string(ld, json::member(ld, it, "type"));
				if bt == "text" {
					let tx, _ = json::as_string(ld, json::member(ld, it, "text"));
					if reply.len > 0 { reply.push('\n'); }
					reply.append(tx);
				} else if bt == "tool_use" {
					let inp = json::member(ld, it, "input");
					let fp1, ok1 = json::as_string(ld, json::member(ld, inp, "file_path"));
					let fp2, ok2 = json::as_string(ld, json::member(ld, inp, "notebook_path"));
					let fp = if ok1 { fp1 } else { fp2 };
					let okf = ok1 || ok2;
					if okf && fp.len > 0 {
						var have = false;
						for f in files { if f[..] == fp { have = true; } }
						if !have { var fb byte[>..] = []; fb.append(fp); files.push(copy(fb)); }
					}
				}
			}
		}
	}
	if prompt.len == 0 { return; }
	let ps = proj_slug(cwd);
	let base = str("conv::", ps, "::");
	let ck = str(base, "count");
	var c = 0;
	if (kfind(ck[..]) >= 0) { let v, okv = parse_int(trim(entry_text(kfind(ck[..])))); if okv { c = v; } }
	let head = str("User: ", prompt, "\n");
	if c > 0 {
		let pk = str(base, "turn_", c);
		if !((kfind(pk[..]) >= 0) && starts_with(entry_text(kfind(pk[..])), head[..])) { c += 1; }
	} else { c = 1; }
	var rec byte[>..] = [];
	rec.append(head[..]);
	rec.append("Assistant: ");
	rec.append(trim(reply[..]));
	rec.push('\n');
	if tools.len > 0 {
		rec.append("Tool:\n");
		rec.append(tools[..]);
		rec.push('\n');
	}
	if files.len > 0 {
		rec.append("Files:");
		for f in files { rec.push(' '); rec.append(f[..]); }
		rec.push('\n');
	}
	save_kb_entry(str(base, "turn_", c)[..], rec[..]);
	save_kb_entry(ck[..], str(c)[..]);
	var stt byte[>..] = [];
	stt.append("[atex] Restored working state for this project (");
	format(stt, c);
	stt.append(" saved turns). Older turns: atex_recall key ");
	stt.append(base[..]);
	stt.append("turn_<n>, or atex_search.\n");
	if files.len > 0 {
		stt.append("Files touched last session:");
		for f in files[max(0, files.len - 20)..] { stt.push(' '); stt.append(f[..]); }
		stt.push('\n');
	}
	for t in max(1, c - 2)..c + 1 {
		let tk = str(base, "turn_", t);
		if !(kfind(tk[..]) >= 0) { continue; }
		stt.append("\n## Turn ");
		format(stt, t);
		stt.push('\n');
		clip(stt, entry_text(kfind(tk[..])), if t == c { 2400 } else { 900 });
		stt.push('\n');
	}
	save_kb_entry(str(base, "latest_state")[..], stt[..]);
}
fn hook_start(d json::Doc&, root int) {
	let src, _ = json::as_string(d, json::member(d, root, "source"));
	let cwd, _ = json::as_string(d, json::member(d, root, "cwd"));
	if src == "startup" { return; }
	let k = str("conv::", proj_slug(cwd), "::latest_state");
	if !(kfind(k[..]) >= 0) { return; }
	var out byte[>..] = [];
	out.append("{\"hookSpecificOutput\":{\"hookEventName\":\"SessionStart\",\"additionalContext\":");
	json::format_string(out, entry_text(kfind(k[..])));
	out.append("}}\n");
	write_stdout(out[..]);
	flush_stdout();
}
fn json_deny(agent const byte[:], user const byte[:]) {
	var out byte[>..] = [];
	out.append("{\"permission\":\"deny\",\"agent_message\":");
	json::format_string(out, agent);
	out.append(",\"user_message\":");
	json::format_string(out, user);
	out.append("}\n");
	write_stdout(out[..]);
	flush_stdout();
}
fn json_allow() {
	write_stdout("{\"permission\":\"allow\"}\n");
	flush_stdout();
}
fn line_keep(ln const byte[:]) bool {
	if find(ln, "CONSTRAINT") >= 0 || find(ln, "Decision") >= 0 || find(ln, "ERROR") >= 0 || find(ln, "def ") >= 0 || find(ln, "return False") >= 0 { return true; }
	if find(ln, "/") >= 0 && ln.len > 8 { return true; }
	var run = 0;
	var i = 0;
	while i < ln.len {
		let c = ln[i];
		if c >= 'A' && c <= 'Z' { run += 1; }
		else if c == '_' || (c >= '0' && c <= '9') { }
		else {
			if run >= 6 { return true; }
			run = 0;
		}
		i += 1;
	}
	run >= 6
}
fn excerpt_keep(raw const byte[:], out byte[>..]&) {
	var n = 0;
	var start = out.len;
	for ln in split(raw, '\n') {
		if line_keep(ln) {
			if out.len > start { out.push('\n'); }
			if ln.len > 240 { out.append(ln[..240]); } else { out.append(ln); }
			n += 1;
			if out.len - start > 700 || n >= 12 { break; }
		}
	}
	if out.len == start {
		let n2 = if raw.len > 400 { 400 } else { raw.len };
		out.append(raw[..n2]);
	}
}
fn tool_path_of(d json::Doc&, root int) byte[>..] {
	var out byte[>..] = [];
	let tin = json::member(d, root, "tool_input");
	let p1, ok1 = json::as_string(d, json::member(d, tin, "path"));
	if ok1 && p1.len > 0 { out.append(p1); return out; }
	let p2, ok2 = json::as_string(d, json::member(d, tin, "file_path"));
	if ok2 && p2.len > 0 { out.append(p2); return out; }
	let p3, ok3 = json::as_string(d, json::member(d, tin, "target_file"));
	if ok3 && p3.len > 0 { out.append(p3); return out; }
	let p4, ok4 = json::as_string(d, json::member(d, root, "file_path"));
	if ok4 { out.append(p4); }
	out
}
fn shell_target(cmd const byte[:]) byte[>..] {
	var out byte[>..] = [];
	var rest const byte[:] = cmd;
	if starts_with(cmd, "cat ") { rest = trim(cmd[4..]); }
	else if starts_with(cmd, "type ") { rest = trim(cmd[5..]); }
	else { return out; }
	if rest.len >= 2 && rest[0] == '"' && rest[rest.len - 1] == '"' { rest = rest[1..rest.len - 1]; }
	let sp = find(rest, " ");
	if sp >= 0 { rest = rest[..sp]; }
	out.append(rest);
	out
}
fn conv_key(d json::Doc&, root int) byte[>..] {
	var out byte[>..] = [];
	let a, oka = json::as_string(d, json::member(d, root, "conversation_id"));
	let b, okb = json::as_string(d, json::member(d, root, "session_id"));
	let src const byte[:] = if oka && a.len > 0 { a } else if okb && b.len > 0 { b } else { "default" };
	var i = 0;
	while i < src.len && out.len < 64 {
		let c = src[i];
		if (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '-' || c == '_' { out.push(c); }
		i += 1;
	}
	if out.len == 0 { out.append("default"); }
	out
}
fn seen_path(conv const byte[:], path const byte[:]) byte[>..] {
	str(ADIR, "/cursor-seen-", conv)
}
fn already_seen(conv const byte[:], path const byte[:]) bool {
	var raw byte[>..] = [];
	let p = seen_path(conv, path);
	if !read_file(p[..], raw) { return false; }
	let needle = str("\n", path, "\n");
	find(str("\n", raw, "\n")[..], needle[..]) >= 0
}
fn mark_seen(conv const byte[:], path const byte[:]) {
	if path.len == 0 || already_seen(conv, path) { return; }
	let p = seen_path(conv, path);
	var prev byte[>..] = [];
	read_file(p[..], prev);
	if prev.len == 0 || prev[prev.len - 1] != '\n' { prev.push('\n'); }
	prev.append(path);
	prev.push('\n');
	write_file(p[..], prev[..]);
}
fn load_bytes(path const byte[:], inline const byte[:], out byte[>..]&) bool {
	if inline.len > 0 { out.append(inline); return true; }
	if path.len == 0 { return false; }
	read_file(path, out)
}
fn shrink_msg(path const byte[:], raw const byte[:], dup bool) byte[>..] {
	var out byte[>..] = [];
	if dup {
		out.append("ATEX duplicate. Already sent this session. Do not read ");
		out.append(path);
		out.append(" again.\n");
	} else {
		out.append("ATEX kept ");
		format(out, raw.len);
		out.append(" chars off the prompt for ");
		out.append(path);
		out.append(".\n");
	}
	excerpt_keep(raw, out);
	out
}
fn consider_path(d json::Doc&, root int, path const byte[:], inline const byte[:], inform_agent bool) bool {
	if path.len == 0 { return false; }
	let conv = conv_key(d, root);
	var raw byte[>..] = [];
	if !load_bytes(path, inline, raw) { return false; }
	let dup = already_seen(conv[..], path);
	if !dup && raw.len <= 1500 {
		mark_seen(conv[..], path);
		return false;
	}
	let msg = shrink_msg(path, raw[..], dup);
	if !dup { mark_seen(conv[..], path); }
	if inform_agent { json_deny(msg[..], msg[..]); }
	else {
		var out byte[>..] = [];
		out.append("{\"permission\":\"deny\",\"user_message\":");
		json::format_string(out, msg[..]);
		out.append("}\n");
		write_stdout(out[..]);
		flush_stdout();
	}
	true
}
fn run_cursor(d json::Doc&, root int) {
	let ev, okev = json::as_string(d, json::member(d, root, "hook_event_name"));
	let event const byte[:] = if okev { ev } else { "" };
	if event == "beforeSubmitPrompt" || event == "UserPromptSubmit" {
		write_stdout("{\"continue\":true}\n");
		flush_stdout();
		return;
	}
	if event == "preCompact" || event == "PreCompact" {
		let tp, okt = json::as_string(d, json::member(d, root, "transcript_path"));
		if okt && tp.len > 0 { hook_stop(d, root); }
		write_stdout("{}\n");
		flush_stdout();
		return;
	}
	if event == "sessionStart" || event == "SessionStart" || event == "start" {
		let cwd, _ = json::as_string(d, json::member(d, root, "cwd"));
		let slug = proj_slug(if cwd.len > 0 { cwd } else { "." });
		let k = str("conv::", slug, "::latest_state");
		var card byte[>..] = [];
		if kfind(k[..]) >= 0 { card.append(entry_text(kfind(k[..]))); }
		var out byte[>..] = [];
		out.append("{\"additional_context\":");
		json::format_string(out, card[..]);
		out.append(",\"hookSpecificOutput\":{\"hookEventName\":\"SessionStart\",\"additionalContext\":");
		json::format_string(out, card[..]);
		out.append("}}\n");
		write_stdout(out[..]);
		flush_stdout();
		return;
	}
	if event == "stop" || event == "Stop" {
		hook_stop(d, root);
		write_stdout("{}\n");
		flush_stdout();
		return;
	}
	if event == "beforeReadFile" {
		let path = tool_path_of(d, root);
		let content, _ = json::as_string(d, json::member(d, root, "content"));
		if consider_path(d, root, path[..], content, false) { return; }
		json_allow();
		return;
	}
	if event == "preToolUse" {
		let tn, _ = json::as_string(d, json::member(d, root, "tool_name"));
		if tn == "Read" || tn == "read_file" || tn == "ReadFile" {
			let path = tool_path_of(d, root);
			if consider_path(d, root, path[..], "", true) { return; }
			json_allow();
			return;
		}
		if tn == "Shell" || tn == "shell" {
			let tin = json::member(d, root, "tool_input");
			let cmd, okc = json::as_string(d, json::member(d, tin, "command"));
			if okc {
				let target = shell_target(cmd);
				if target.len > 0 && consider_path(d, root, target[..], "", true) { return; }
			}
			json_allow();
			return;
		}
		json_allow();
		return;
	}
	if event == "postToolUse" {
		let mcp, okm = json::as_string(d, json::member(d, root, "mcp_server_name"));
		let tn, _ = json::as_string(d, json::member(d, root, "tool_name"));
		let output, oko = json::as_string(d, json::member(d, root, "tool_output"));
		let is_mcp = (okm && mcp.len > 0) || starts_with(tn, "MCP:");
		if is_mcp && oko && output.len > 800 {
			var msg byte[>..] = [];
			msg.append("ATEX trimmed MCP output from ");
			format(msg, output.len);
			msg.append(" chars.\n");
			excerpt_keep(output, msg);
			var out byte[>..] = [];
			out.append("{\"updated_mcp_tool_output\":{\"text\":");
			json::format_string(out, msg[..]);
			out.append("}}\n");
			write_stdout(out[..]);
			flush_stdout();
			return;
		}
		write_stdout("{}\n");
		flush_stdout();
		return;
	}
	write_stdout("{}\n");
	flush_stdout();
}
fn run_hook(kind const byte[:]) {
	var inp byte[>..] = [];
	read_stdin(inp);
	var d = json::Doc {};
	let root, _ = json::parse(trim(inp[..]), d);
	if kind == "cursor" {
		if root < 0 { write_stdout("{}\n"); flush_stdout(); return; }
		run_cursor(d, root);
		return;
	}
	if root < 0 { return; }
	if kind == "stop" { hook_stop(d, root); }
	else if kind == "start" { hook_start(d, root); }
}
fn is_section(id int) bool {
	let k = ekey(id);
	let p = rfind(k, "::");
	let f = find(k, "::");
	p > f && f >= 0 && (kfind(k[..p]) >= 0)
}
fn line_of(txt const byte[:], at int) int {
	var n = 1;
	for i in 0..min(at, txt.len) { if txt[i] == '\n' { n += 1; } }
	n
}
fn where_text(q const byte[:], k int, scope const byte[:]) byte[>..] {
	var res byte[>..] = [];
	var terms = query_terms(q);
	let hits = rank(terms);
	WH_ID.clear();
	var seen = dictionary<int, int> {};
	var rest = 0;
	var dn byte[>..][>..] = [];
	var dc int[>..] = [];
	var st int[>..] = [];
	var sc uint[>..] = [];
	var df bool[>..] = [];
	for h in hits {
		var id = h.id;
		if is_section(id) {
			let kk = ekey(id);
			id = kfind(kk[..rfind(kk, "::")]);
		}
		if id < 0 || ENTRIES[id].len == 0 || contains(seen, id) { continue; }
		insert(seen, id, 1);
		let key = ekey(id);
		let cp = find(key, "::");
		let rel = if cp >= 0 { key[cp + 2..] } else { key };
		if scope.len > 0 && !starts_with(rel, scope) && !starts_with(key, scope) { continue; }
		if WH_ID.len >= k || (h.conf == 0 && WH_ID.len > 0) {
			rest += 1;
			let sl = rfind(rel, "/");
			let dir = if sl > 0 { rel[..sl + 1] } else { "./" };
			var at = -1;
			for i in 0..dn.len { if dn[i][..] == dir { at = i; } }
			if at < 0 {
				dn.push(str(dir));
				dc.push(1);
			} else { dc[at] += 1; }
			continue;
		}
		st.clear();
		sc.clear();
		df.clear();
		let txt = entry_text(id);
		scan_lines(txt, terms, st, sc, df);
		var order int[>..] = [];
		for j in 0..sc.len { if sc[j] != 0 { order.push(j); } }
		WH_ID.push(id);
		res.append(key);
		if order.len == 0 {
			res.append(" (name only)\n");
			continue;
		}
		sort(order[..]) { x, y => line_value(terms, sc, df, x) > line_value(terms, sc, df, y) || (line_value(terms, sc, df, x) == line_value(terms, sc, df, y) && x < y) };
		res.push(' ');
		format(res, order.len);
		res.push(':');
		for j in 0..min(order.len, 3) {
			res.append(" L");
			format(res, order[j] + 1);
		}
		res.append("\n  ");
		let best = trim(txt[st[order[0]]..min(st[order[0] + 1], txt.len)]);
		res.append(best[..min(best.len, 120)]);
		res.push('\n');
	}
	if WH_ID.len == 0 {
		res.append("(no stored entry contains these terms; atex_search exact=true scans raw text)");
		return res;
	}
	if FUZZY_ID.len > 0 {
		var note byte[>..] = [];
		note.append("(no exact match for ");
		note.append(FUZZY_ID[..]);
		note.append("; partial matches)\n");
		note.append(res[..]);
		return note;
	}
	if rest > 0 {
		res.append("[+");
		format(res, rest);
		res.append(" more files:");
		for i in 0..min(dn.len, 7) {
			res.push(' ');
			res.append(dn[i][..]);
			res.push(' ');
			format(res, dc[i]);
		}
		res.append("; path= narrows]");
	}
	res
}
fn file_query_text(key const byte[:], txt const byte[:], q const byte[:], mc int) byte[>..] {
	var res byte[>..] = [];
	var terms = query_terms(q);
	var ids int[>..] = [];
	for ti in 0..terms.len { weigh_term(terms, ti, ENTRIES.len + 1, ids); }
	var st int[>..] = [];
	var sc uint[>..] = [];
	var df bool[>..] = [];
	scan_lines(txt, terms, st, sc, df);
	let nl = sc.len;
	var order int[>..] = [];
	for j in 0..nl { if sc[j] != 0 { order.push(j); } }
	res.append(key);
	if order.len == 0 {
		res.append(" has no matching lines");
		return res;
	}
	sort(order[..]) { x, y => line_value(terms, sc, df, x) > line_value(terms, sc, df, y) || (line_value(terms, sc, df, x) == line_value(terms, sc, df, y) && x < y) };
	var keep bool[>..] = [];
	keep.resize(nl, false);
	var used = 0;
	var shown = 0;
	for j in order {
		let a = max(j - 1, 0);
		let b = min(j + 1, nl - 1);
		var add = 0;
		for x in a..b + 1 { if !keep[x] { add += st[x + 1] - st[x]; } }
		if shown > 0 && mc > 0 && used + add > mc { break; }
		for x in a..b + 1 { keep[x] = true; }
		used += add;
		shown += 1;
	}
	res.push(' ');
	format(res, order.len);
	res.append(" of ");
	format(res, nl);
	res.append(" lines match\n");
	var x = 0;
	while x < nl {
		if !keep[x] {
			x += 1;
			continue;
		}
		var y = x;
		while y + 1 < nl && keep[y + 1] { y += 1; }
		res.push('L');
		format(res, x + 1);
		res.push('-');
		format(res, y + 1);
		res.push('\n');
		let body = txt[st[x]..min(st[y + 1], txt.len)];
		if mc > 0 && body.len > mc + 200 { res.append(body[..mc]); res.append("...\n"); } else { res.append(body); }
		if res[res.len - 1] != '\n' { res.push('\n'); }
		x = y + 1;
	}
	if shown < order.len {
		res.append("[+");
		format(res, order.len - shown);
		res.append(" more:");
		for j in shown..min(order.len, shown + 8) {
			res.append(" L");
			format(res, order[j] + 1);
		}
		res.append("]");
	}
	res
}
fn search_text(q const byte[:], k int, mc int, page int) byte[>..] {
	var res byte[>..] = [];
	var terms = query_terms(q);
	let hits = rank(terms);
	RES_ID.clear();
	RES_S.clear();
	RES_E.clear();
	RES_AL.clear();
	var dbg byte[>..] = [];
	if env("ATEX_DEBUG", dbg) && dbg.len > 0 {
		for t in terms { write_stderr(str("[term] ", t.w[..], " wt=", t.wt, "\n")[..]); }
		for h in hits[..min(hits.len, 8)] { write_stderr(str("[hit] ", ekey(h.id), " score=", h.score, " conf=", h.conf, "\n")[..]); }
	}
	if hits.len == 0 { res.append("(no stored entry contains these terms; exact=true scans raw text)"); return res; }
	let pg = max(1, page);
	var j = (pg - 1) * k;
	var seen byte[>..][>..] = [];
	var dups int[>..] = [];
	var body byte[>..] = [];
	var cnt = 0;
	while j < hits.len && cnt < k {
		let h = hits[j];
		if pg == 1 && h.conf == 0 { break; }
		j += 1;
		body.clear();
		let txt = entry_text(h.id);
		snippet(txt, terms, mc, body);
		var bl byte[>..] = [];
		bl.append(trim(txt[SN_B0..SN_B1]));
		var dup = false;
		for p in seen { if p[..] == bl[..] { dup = true; } }
		if dup { dups.push(h.id); continue; }
		seen.push(copy(bl));
		RES_ID.push(h.id);
		RES_S.push(SN_S);
		RES_E.push(SN_E);
		for x in SN_ALSO { RES_AL.push(h.id); RES_AL.push(x); }
		if res.len > 0 { res.push('\n'); }
		res.append("--- ");
		res.append(ekey(h.id));
		res.append(body[..]);
		cnt += 1;
	}
	let rest = hits.len - j;
	if rest > 0 || dups.len > 0 {
		if res.len > 0 { res.push('\n'); }
		res.append("[");
		if dups.len > 0 {
			res.append("same lines also in:");
			for d in dups { res.push(' '); res.append(ekey(d)); }
			if rest > 0 { res.append("; "); }
		}
		if rest > 0 {
			res.append("+");
			format(res, rest);
			res.append(if cnt == 0 && pg == 1 { " weak matches: " } else { " more: " });
			var shown = 0;
			var m = j;
			while m < hits.len && shown < 8 { if shown > 0 { res.append(" · "); } res.append(ekey(hits[m].id)); shown += 1; m += 1; }
			if rest > shown { res.append(" …"); }
			res.append("; page=");
			format(res, if cnt == 0 && pg == 1 { 2 } else { pg + 1 });
		}
		res.append("]");
	}
	res
}
fn exact_text(q const byte[:], k int, mc int, page int) byte[>..] {
	var res byte[>..] = [];
	var lq byte[>..] = [];
	lower_into(q, lq);
	if lq.len == 0 { res.append("(empty query)"); return res; }
	var lb byte[>..] = [];
	var total = 0;
	var ents = 0;
	let rpp = max(1, (k * mc) / 160);
	let skip = (max(1, page) - 1) * rpp;
	var hit_ent bool[>..] = [];
	for id in 0..ENTRIES.len { hit_ent.push(false); }
	for pass in 0..2 {
		for id in 0..ENTRIES.len {
			if is_section(id) { continue; }
			let txt = entry_text(id);
			var a = 0;
			var ln = 1;
			while a < txt.len {
				var e = a;
				while e < txt.len && txt[e] != '\n' { e += 1; }
				let cs = find(txt[a..e], q);
				var mp = -1;
				if pass == 0 { mp = cs; } else if cs < 0 { lower_into(txt[a..e], lb); mp = find(lb[..], lq[..]); }
				if mp >= 0 {
					if total >= skip && total < skip + rpp {
						res.append(ekey(id));
						res.append(":L");
						format(res, ln);
						res.append(": ");
						let w0 = if e - a > 240 { max(0, min(mp - 80, e - a - 240)) } else { 0 };
						let w1 = min(e - a, w0 + 240);
						if w0 > 0 { res.append("..."); }
						res.append(trim(txt[a + w0..a + w1]));
						if w1 < e - a { res.append("..."); }
						res.push('\n');
					}
					total += 1;
					if !hit_ent[id] { hit_ent[id] = true; ents += 1; }
				}
				a = e + 1;
				ln += 1;
			}
		}
	}
	if total == 0 { res.append("(no stored text contains this string)"); return res; }
	res.append("[");
	format(res, total);
	res.append(" matching lines in ");
	format(res, ents);
	res.append(" entries");
	if total > skip + rpp { res.append("; page="); format(res, max(1, page) + 1); }
	res.append("]");
	res
}
fn slice_lines(txt const byte[:], spec const byte[:], out byte[>..]&) bool {
	let dash = find(spec, "-");
	let a, oka = parse_int(trim(if dash >= 0 { spec[..dash] } else { spec }));
	let b, okb = if dash >= 0 { parse_int(trim(spec[dash + 1..])) } else { parse_int(trim(spec)) };
	if !oka || !okb || a < 1 || b < a { return false; }
	var ln = 1;
	var p = 0;
	while p < txt.len && ln < a { if txt[p] == '\n' { ln += 1; } p += 1; }
	var e = p;
	while e < txt.len && ln <= b { if txt[e] == '\n' { ln += 1; if ln > b { break; } } e += 1; }
	out.append(txt[p..e]);
	true
}
var GREP_HIT = false;
fn grep_route(q const byte[:], ex const byte[:]) int {
	var words byte[>..][>..] = [];
	var i = 0;
	while i < q.len {
		if !is_tok_lead(q[i]) {
			i += 1;
			continue;
		}
		var w byte[>..] = [];
		while i < q.len && is_tok_cont(q[i]) {
			w.push(lower(q[i]));
			i += 1;
		}
		if w.len > 2 && !is_stop(w[..]) { words.push(copy(w)); }
	}
	var low byte[>..] = [];
	var best = -1;
	var bn = 0;
	for wi in 0..words.len {
		var n = 0;
		for id in 0..ENTRIES.len {
			if ENTRIES[id].len == 0 || is_section(id) || !starts_with(ekey(id), "project::") { continue; }
			for ln in split(entry_text(id), '\n') {
				lower_into(ln, low);
				if find(low[..], words[wi][..]) >= 0 { n += 1; }
			}
		}
		if n > 0 && (best < 0 || n < bn) {
			best = wi;
			bn = n;
		}
	}
	GREP_HIT = false;
	if best < 0 { return 0; }
	var out byte[>..] = [];
	var shown = 0;
	for id in 0..ENTRIES.len {
		if shown >= 30 { break; }
		if ENTRIES[id].len == 0 || is_section(id) || !starts_with(ekey(id), "project::") { continue; }
		var no = 0;
		for ln in split(entry_text(id), '\n') {
			no += 1;
			lower_into(ln, low);
			if shown < 30 && find(low[..], words[best][..]) >= 0 {
				out.append(ekey(id)[9..]);
				out.push(':');
				format(out, no);
				out.push(':');
				out.append(ln[..min(ln.len, 200)]);
				out.push('\n');
				shown += 1;
			}
		}
	}
	var lo byte[>..] = [];
	lower_into(out[..], lo);
	var le byte[>..] = [];
	lower_into(ex, le);
	GREP_HIT = find(lo[..], le[..]) >= 0;
	out.len
}
fn run_bench(tsv const byte[:]) {
	var raw byte[>..] = [];
	if !read_file(tsv, raw) { write_stderr("[atex bench] cannot read question file\n"); return; }
	var n = 0;
	var a_hit = 0;
	var a_sum = 0;
	var f_hit = 0;
	var f_sum = 0;
	var w_sum = 0;
	var l_hit = 0;
	var x_hit = 0;
	var t_first = 0;
	var t_hit = 0;
	var t_sum = 0;
	var t_full = 0;
	var g_first = 0;
	var g_full = 0;
	var rows byte[>..] = [];
	for ln in split(raw[..], '\n') {
		if ln.len == 0 || ln[0] == '#' { continue; }
		let p1 = find(ln, "\t");
		if p1 < 0 { continue; }
		let rest = ln[p1 + 1..];
		let p2 = find(rest, "\t");
		if p2 < 0 { continue; }
		let q = ln[..p1];
		let ex = rest[..p2];
		let fp = trim(rest[p2 + 1..]);
		let res = search_text(q, DEF_K, DEF_MC, 1);
		let ah = find(res[..], ex) >= 0;
		var fr byte[>..] = [];
		read_file(fp, fr);
		let fc = min(fr.len, 46080);
		let at = find(fr[..], ex);
		var lo = ah;
		for i in 0..RES_ID.len {
			if lo { break; }
			let et = entry_text(RES_ID[i]);
			var p = 0;
			while !lo && p < et.len {
				let f = find(et[p..], ex);
				if f < 0 { break; }
				let al = line_of(et, p + f);
				if al >= RES_S[i] && al <= RES_E[i] { lo = true; }
				var j = 0;
				while j + 1 < RES_AL.len { if RES_AL[j] == RES_ID[i] && RES_AL[j + 1] == al { lo = true; } j += 2; }
				p = p + f + 1;
			}
		}
		if lo { l_hit += 1; }
		let wr = where_text(q, DEF_K, "");
		var tc = wr.len;
		var th = find(wr[..], ex) >= 0;
		if th { t_first += 1; }
		var hop = 0;
		while !th && hop < min(WH_ID.len, 1) {
			let fq = file_query_text(ekey(WH_ID[hop]), entry_text(WH_ID[hop]), q, DEF_MC);
			tc += fq.len;
			th = find(fq[..], ex) >= 0;
			hop += 1;
		}
		if th { t_hit += 1; }
		t_sum += tc;
		let xr = exact_text(ex, DEF_K, DEF_MC, 1);
		let xh = find(xr[..], ex) >= 0;
		if xh { x_hit += 1; }
		var wc = 0;
		if at >= 0 {
			var s = at;
			var c = 0;
			while s > 0 { if fr[s - 1] == '\n' { c += 1; if c > 20 { break; } } s -= 1; }
			var e = at;
			c = 0;
			while e < fr.len { if fr[e] == '\n' { c += 1; if c > 20 { break; } } e += 1; }
			wc = e - s;
		}
		n += 1;
		if ah { a_hit += 1; }
		if at >= 0 && at < 46080 { f_hit += 1; }
		a_sum += res.len;
		f_sum += fc;
		w_sum += wc;
		t_full += tc + (if th { 0 } else { wc });
		let gc = grep_route(q, ex);
		if GREP_HIT { g_first += 1; }
		g_full += gc + (if GREP_HIT { 0 } else { wc });
		if rows.len > 0 { rows.push(','); }
		rows.append("\n{\"query\":");
		json::format_string(rows, q);
		rows.append(",\"atex_chars\":");
		format(rows, res.len);
		rows.append(",\"atex_has_answer\":");
		rows.append(if ah { "true" } else { "false" });
		rows.append(",\"located\":");
		rows.append(if lo { "true" } else { "false" });
		rows.append(",\"exact_has_answer\":");
		rows.append(if xh { "true" } else { "false" });
		rows.append(",\"whole_file_chars\":");
		format(rows, fc);
		rows.append(",\"window41_chars\":");
		format(rows, wc);
		rows.append(",\"tier_chars\":");
		format(rows, tc);
		rows.append(",\"tier_has_answer\":");
		rows.append(if th { "true" } else { "false" });
		rows.append("}");
	}
	var out byte[>..] = [];
	out.append("{\"engine\":\"atex 0.3.6\",\"k\":");
	format(out, DEF_K);
	out.append(",\"max_chars\":");
	format(out, DEF_MC);
	out.append(",\"questions\":");
	format(out, n);
	out.append(",\"atex_answer_hits\":");
	format(out, a_hit);
	out.append(",\"atex_located\":");
	format(out, l_hit);
	out.append(",\"exact_answer_hits\":");
	format(out, x_hit);
	out.append(",\"atex_total_chars\":");
	format(out, a_sum);
	out.append(",\"whole_file_answer_hits\":");
	format(out, f_hit);
	out.append(",\"whole_file_total_chars\":");
	format(out, f_sum);
	out.append(",\"window41_total_chars\":");
	format(out, w_sum);
	out.append(",\"tier_first_hits\":");
	format(out, t_first);
	out.append(",\"tier_answer_hits\":");
	format(out, t_hit);
	out.append(",\"tier_total_chars\":");
	format(out, t_sum);
	out.append(",\"tier_route_chars\":");
	format(out, t_full);
	out.append(",\"grep_first_hits\":");
	format(out, g_first);
	out.append(",\"grep_route_chars\":");
	format(out, g_full);
	out.append(",\"rows\":[");
	out.append(rows[..]);
	out.append("\n]}\n");
	write_stdout(out[..]);
	flush_stdout();
}
struct RpEv { k int, a int, b int }
struct RpPol { name byte[>..], cap int, mask int, rho real, win int, trig int, keep int, least int, fresh int, trim int }
struct RpRes { tok real, rd real, wr real, out real, resets int }
fn rp_num(d json::Doc&, u int, name const byte[:]) int {
	let v, ok = json::as_i64(d, json::member(d, u, name));
	if ok { v as int } else { 0 }
}
fn rp_cappable(n const byte[:]) int {
	if n == "Bash" { 1 } else if (n == "WebFetch" || n == "WebSearch" || starts_with(n, "mcp__")) && !starts_with(n, "mcp__amnitex") { 2 } else { 0 }
}
fn rp_parse(raw const byte[:], ev RpEv[>..]&) {
	var ld = json::Doc {};
	var last_id byte[>..] = [];
	var tools = dictionary<uint, int> {};
	for ln in split(raw, '\n') {
		if find(ln, "\"type\":\"user\"") < 0 && find(ln, "\"type\":\"assistant\"") < 0 { continue; }
		let r, _ = json::parse(ln, ld);
		if r < 0 { continue; }
		let sc, oks = json::as_bool(ld, json::member(ld, r, "isSidechain"));
		let mt, okm = json::as_bool(ld, json::member(ld, r, "isMeta"));
		if (oks && sc) || (okm && mt) { continue; }
		let ty, _ = json::as_string(ld, json::member(ld, r, "type"));
		let msg = json::member(ld, r, "message");
		let ct = json::member(ld, msg, "content");
		if ty == "assistant" {
			let id, _ = json::as_string(ld, json::member(ld, msg, "id"));
			let u = json::member(ld, msg, "usage");
			let total = rp_num(ld, u, "input_tokens") + rp_num(ld, u, "cache_read_input_tokens") + rp_num(ld, u, "cache_creation_input_tokens");
			if id != last_id[..] && total >= 1000 {
				last_id.clear();
				last_id.append(id);
				ev.push(RpEv { k: 0, a: total, b: rp_num(ld, u, "output_tokens") });
			}
			for i in 0..json::count(ld, ct) {
				let it = json::element(ld, ct, i);
				let bt, _ = json::as_string(ld, json::member(ld, it, "type"));
				if bt == "tool_use" {
					let tid, _ = json::as_string(ld, json::member(ld, it, "id"));
					let nm, _ = json::as_string(ld, json::member(ld, it, "name"));
					let inp = json::member(ld, it, "input");
					insert(tools, hash(tid), if nm == "Read" && json::member(ld, inp, "limit") < 0 && json::member(ld, inp, "offset") < 0 { 4 } else { rp_cappable(nm) });
				}
			}
		} else {
			let s, isstr = json::as_string(ld, ct);
			var real_text = false;
			if isstr { let t = trim(s); real_text = t.len > 0 && !starts_with(t, "<command") && !starts_with(t, "<local-command") && !starts_with(t, "Caveat:") && !starts_with(t, "<system-reminder"); } else {
				for i in 0..json::count(ld, ct) {
					let it = json::element(ld, ct, i);
					let bt, _ = json::as_string(ld, json::member(ld, it, "type"));
					if bt == "tool_result" {
						let tid, _ = json::as_string(ld, json::member(ld, it, "tool_use_id"));
						let c = json::member(ld, it, "content");
						let cs, okc = json::as_string(ld, c);
						var n = if okc { cs.len } else { 0 };
						if !okc { for j in 0..json::count(ld, c) { let tx, okt = json::as_string(ld, json::member(ld, json::element(ld, c, j), "text")); if okt { n += tx.len; } } }
						ev.push(RpEv { k: 1, a: n, b: get(tools, hash(tid), 0) });
					} else if bt == "text" {
						let tx, _ = json::as_string(ld, json::member(ld, it, "text"));
						let t = trim(tx);
						if t.len > 0 && !starts_with(t, "<command") && !starts_with(t, "<local-command") && !starts_with(t, "Caveat:") && !starts_with(t, "<system-reminder") { real_text = true; }
					}
				}
			}
			if real_text { ev.push(RpEv { k: 2, a: 0, b: 0 }); }
		}
	}
}
fn rp_is_drop(prev int, cur int) bool { prev > 0 && cur * 10 < prev * 7 && prev - cur > 30000 }
fn rp_sim(ev const RpEv[:], p const RpPol&, r real, post int, base int) RpRes {
	var t = RpRes { tok: 0.0, rd: 0.0, wr: 0.0, out: 0.0, resets: 0 };
	var removed = 0;
	var prev = 0;
	var last = 0;
	var live int[>..] = [];
	var live0 = 0;
	for e in ev {
		if e.k == 2 {
			if p.fresh > 0 && last > 0 {
				removed = max(0, last - base - p.fresh);
				live.clear();
				live0 = 0;
				prev = min(prev, base - p.trim);
				t.resets += 1;
			}
		} else if e.k == 1 {
			var tk = (e.a as real * r) as int;
			if p.cap > 0 && (e.b & p.mask) != 0 && tk > p.cap {
				removed += ((1.0 - p.rho) * (tk - p.cap) as real) as int;
				tk = p.cap;
			}
			live.push(tk);
		} else {
			if rp_is_drop(last, e.a) {
				removed = 0;
				live.clear();
				live0 = 0;
				prev = base - p.trim;
			}
			last = e.a;
			var c = max(e.a - removed, min(e.a, base)) - p.trim;
			if p.win > 0 && c > p.win {
				t.rd += c as real;
				t.tok += c as real;
				t.out += 8000.0;
				t.resets += 1;
				removed = max(0, e.a - post);
				c = min(e.a, post) - p.trim;
				live.clear();
				live0 = 0;
				prev = base - p.trim;
			} else if p.trig > 0 && c > p.trig && live.len - p.keep > live0 {
				var sum = 0;
				for i in live0..live.len - p.keep { sum += live[i]; }
				if sum >= p.least {
					removed += sum;
					c = max(c - sum, base - p.trim);
					live0 = live.len - p.keep;
					prev = min(prev, base - p.trim);
					t.resets += 1;
				}
			}
			t.tok += c as real;
			t.rd += min(prev, c) as real;
			t.wr += max(0, c - prev) as real;
			prev = c;
		}
	}
	t
}
fn rp_cost(t const RpRes&, w real) real { t.rd * 0.05 + t.wr * w + t.out * 5.0 }
fn rp_pol(name const byte[:], cap int, mask int, win int, trig int, fresh int, trim int) RpPol { RpPol { name: str(name), cap: cap * 1000, mask: mask, rho: 0.3, win: win * 1000, trig: trig * 1000, keep: 3, least: 20000, fresh: fresh, trim: trim * 1000 } }
fn run_replay(dir0 const byte[:]) {
	var dir = str(dir0);
	if dir.len == 0 { var hm byte[>..] = []; env("HOME", hm); dir = str(hm, "/.claude/projects"); }
	var files byte[>..][>..] = [];
	var mts int[>..] = [];
	var names byte[>..] = [];
	if !list_dir(dir[..], names) { write_stderr(str("[atex replay] cannot read ", dir, "\n")[..]); exit(1); }
	for nm in split(names[..], '\n') {
		if nm.len == 0 { continue; }
		let sub = str(dir, "/", nm);
		var ff byte[>..] = [];
		if is_dir(sub) && list_dir(sub[..], ff) { for f in split(ff[..], '\n') { if ends_with(f, ".jsonl") { let full = str(sub, "/", f); files.push(copy(full)); mts.push(file_mtime(full[..])); } } }
	}
	var order int[>..] = [];
	for i in 0..files.len { order.push(i); }
	sort(order[..]) { x, y => mts[x] > mts[y] };
	var sessions RpEv[>..][>..] = [];
	var raw byte[>..] = [];
	var scanned = 0;
	for o in order {
		if sessions.len >= 20 { break; }
		raw.clear();
		if !read_file(files[o][..], raw) { continue; }
		scanned += 1;
		var ev RpEv[>..] = [];
		rp_parse(raw[..], ev);
		var calls = 0;
		for e in ev { if e.k == 0 { calls += 1; } }
		if calls >= 300 { sessions.push(copy(ev)); }
	}
	raw.clear();
	var ratios real[>..] = [];
	var posts int[>..] = [];
	var bases int[>..] = [];
	var calls = 0;
	var turns = 0;
	for ev in sessions {
		var last = 0;
		var out = 0;
		var chars = 0;
		var clean = true;
		var base = 0;
		for e in ev {
			if e.k == 1 { chars += e.a; } else if e.k == 2 { turns += 1; clean = false; } else {
				calls += 1;
				base = if base == 0 { e.a } else { min(base, e.a) };
				if rp_is_drop(last, e.a) { posts.push(e.a); }
				else if last > 0 && clean && chars >= 20000 { ratios.push((e.a - last - out) as real / chars as real); }
				last = e.a;
				out = e.b;
				chars = 0;
				clean = true;
			}
		}
		bases.push(base);
	}
	sort(posts[..]) { x, y => x < y };
	let med_base = if bases.len > 0 { var b2 = copy(bases); sort(b2[..]) { x, y => x < y }; b2[b2.len / 2] } else { 0 };
	let post = if posts.len > 0 { posts[posts.len / 2] } else { med_base + 20000 };
	sort(ratios[..]) { x, y => x < y };
	let r = if ratios.len > 0 { max(ratios[ratios.len / 2], 0.1) } else { 0.28 };
	var pols RpPol[>..] = [];
	pols.push(rp_pol("today", 0, 0, 0, 0, 0, 0));
	pols.push(rp_pol("compact at 200K", 0, 0, 200, 0, 0, 0));
	pols.push(rp_pol("compact at 250K", 0, 0, 250, 0, 0, 0));
	pols.push(rp_pol("compact at 300K", 0, 0, 300, 0, 0, 0));
	pols.push(rp_pol("cap Bash 2K", 2, 1, 0, 0, 0, 0));
	pols.push(rp_pol("cap Bash+MCP+web 2K", 2, 3, 0, 0, 0, 0));
	pols.push(rp_pol("cap Bash+MCP+web 1K", 1, 3, 0, 0, 0, 0));
	pols.push(rp_pol("cap all + whole-file Read 2K", 2, 7, 0, 0, 0, 0));
	pols.push(rp_pol("cap Bash 2K + compact 250K", 2, 1, 250, 0, 0, 0));
	pols.push(rp_pol("cap Bash 1K + compact 250K", 1, 1, 250, 0, 0, 0));
	pols.push(rp_pol("cap Bash 2K, compact 250K, start -10K", 2, 1, 250, 0, 0, 10));
	pols.push(rp_pol("clear old results (API), 40K", 0, 0, 0, 40, 0, 0));
	pols.push(rp_pol("fresh turn, 10K re-read", 0, 0, 0, 0, 11100, 0));
	pols.push(rp_pol("fresh turn, 30K re-read", 0, 0, 0, 0, 31100, 0));
	pols.push(rp_pol("cap Bash 2K, compact 250K, fresh 10K", 2, 1, 250, 0, 11100, 0));
	pols.push(rp_pol("cap Bash 2K, compact 250K, fresh 30K", 2, 1, 250, 0, 31100, 0));
	var totals RpRes[>..] = [];
	var per real[>..][>..] = [];
	for k in 0..pols.len { totals.push(RpRes { tok: 0.0, rd: 0.0, wr: 0.0, out: 0.0, resets: 0 }); per.push([]); }
	var idx = 0;
	for ev in sessions {
		let base = bases[idx];
		idx += 1;
		var base_cost = 1.0;
		for k in 0..pols.len {
			let t = rp_sim(ev[..], pols[k], r, post, base);
			totals[k].tok += t.tok;
			totals[k].rd += t.rd;
			totals[k].wr += t.wr;
			totals[k].out += t.out;
			totals[k].resets += t.resets;
			if k == 0 { base_cost = max(rp_cost(t, 2.0), 1.0); }
			per[k].push(100.0 * (1.0 - rp_cost(t, 2.0) / base_cost));
		}
	}
	write_stdout(str("[atex replay] input_tokens=", (totals[0].tok / 1000000.0) as int, "M sessions=", sessions.len, " scanned=", scanned, " calls=", calls, " user_turns=", turns, " tokens_per_char=", fmt(r, 3), " median_start=", med_base, " median_after_compact=", post, "\n")[..]);
	write_stdout("modeled from logged usage; no model calls. cost uses cache read 0.05x, compaction summary 8K output at 5x, and cache write 1.25x or 2x.\n\npolicy                         input saved   cost saved(1.25x)   cost saved(2x)   median session(2x)   resets\n");
	let b = totals[0];
	for k in 0..pols.len {
		sort(per[k][..]) { x, y => x < y };
		let t = totals[k];
		let med = if per[k].len > 0 { per[k][per[k].len / 2] } else { 0.0 };
		var row = str(pols[k].name);
		while row.len < 39 { row.push(' '); }
		write_stdout(str(row, fmt(100.0 * (1.0 - t.tok / max(b.tok, 1.0)), 1), "%          ", fmt(100.0 * (1.0 - rp_cost(t, 1.25) / max(rp_cost(b, 1.25), 1.0)), 1), "%               ", fmt(100.0 * (1.0 - rp_cost(t, 2.0) / max(rp_cost(b, 2.0), 1.0)), 1), "%            ", fmt(med, 1), "%             ", t.resets, "\n")[..]);
	}
	flush_stdout();
}
fn main() {
	let av = args();
	var dir byte[>..] = [];
	var proj byte[>..] = [];
	var cmd byte[>..] = [];
	var i = 1;
	while i < av.len {
		let a = av[i];
		if a == "--version" || a == "-v" {
			write_stdout("atex 0.4.0 (gold/helium-native)\n");
			flush_stdout();
			return;
		} else if a == "--help" || a == "-h" || a == "help" {
			write_stdout("atex 0.4.0 (gold/helium-native)\nUsage:\n  atex [serve] [--atex-dir <dir>]     Run MCP stdio server\n  atex init [project_dir] [--atex-dir <dir>]  Index project docs & code into KB\n  atex install [--atex-dir <dir>] [--no-compact-window]  Wire Claude Code, Cursor, Windsurf, Gemini, Codex, Grok\n  atex uninstall                      Remove the wiring; knowledge bases stay\n  atex doctor                         Check the wiring\n  atex replay [projects_dir]          Model what each setting would have saved on your own Claude Code sessions\n  atex stats [--atex-dir <dir>]       Print knowledge base statistics\n  atex bench <questions.tsv>          Measure answer recall and output size vs whole-file reads\n  atex --selftest                     Run end-to-end TexGrid & byte-page self-test\n");
			flush_stdout();
			return;
		} else if a == "--selftest" || a == "selftest" {
			exit(run_selftest());
		} else if a == "--no-compact-window" {
			NO_WINDOW = true;
			i += 1;
		} else if a == "--atex-dir" && i + 1 < av.len {
			dir.clear();
			dir.append(av[i + 1]);
			i += 2;
		} else if cmd.len == 0 && (a == "serve" || a == "init" || a == "install" || a == "stats" || a == "bench" || a == "hook" || a == "replay" || a == "doctor" || a == "uninstall") {
			cmd.append(a);
			i += 1;
		} else if (cmd == "init" || cmd == "bench" || cmd == "hook" || cmd == "replay") && proj.len == 0 && a[0] != '-' {
			proj.append(a);
			i += 1;
		} else { i += 1; }
	}
	if dir.len == 0 { resolve_default_dir(dir); }
	if cmd == "init" {
		if proj.len == 0 { proj.append("."); }
		run_init(proj[..], dir[..]);
		return;
	}
	if cmd == "install" {
		let b0 = if av.len > 0 { av[0] } else { "atex" };
		run_install(b0, dir[..]);
		return;
	}
	if cmd == "doctor" { run_doctor(); return; }
	if cmd == "uninstall" { run_uninstall(); return; }
	if cmd == "replay" { run_replay(proj[..]); return; }
	if cmd == "hook" && proj == "tool" { hook_tool(dir[..]); return; }
	if !load_kb(dir[..]) {
		write_stderr("[atex serve] ERROR: failed to load or create index.json\n");
		exit(1);
	}
	if cmd == "bench" { run_bench(proj[..]); return; }
	if cmd == "hook" { run_hook(proj[..]); return; }
	if cmd == "stats" {
		let st = format_stats_line();
		write_stdout(str(st, "\n")[..]);
		flush_stdout();
		return;
	}
	var line byte[>..] = [];
	var d = json::Doc {};
	while read_line(line) {
		let s = trim(line[..]);
		if s.len == 0 { line.clear(); continue; }
		let root, err = json::parse(s, d);
		if root < 0 {
			send_err(d, -1, -32700, "parse error");
			line.clear();
			continue;
		}
		let id_node = json::member(d, root, "id");
		let m, _ = json::as_string(d, json::member(d, root, "method"));
		if m == "initialized" || m == "notifications/initialized" { line.clear(); continue; }
		if m == "initialize" {
			var out byte[>..] = [];
			out.append("{\"jsonrpc\":\"2.0\",");
			write_id(out, d, id_node);
			out.append(",\"result\":{\"protocolVersion\":\"2024-11-05\",\"capabilities\":{\"tools\":{}},\"serverInfo\":{\"name\":\"atex-gold\",\"version\":\"0.3.6\"}}}\n");
			write_stdout(out[..]);
			flush_stdout();
		} else if m == "tools/list" {
			var out byte[>..] = [];
			out.append("{\"jsonrpc\":\"2.0\",");
			write_id(out, d, id_node);
			out.append(",\"result\":{\"tools\":[{\"name\":\"atex_search\",\"description\":\"Keyword search over the local atex knowledge base. Returns each matching key with a line range, the best-matching lines, and an also: list of every other matching line number. A footer enumerates all remaining matching keys; pass page=N for the next set. exact=true scans all stored text for a literal case-insensitive string and returns key:line rows. Try it before reading whole files.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"query\":{\"type\":\"string\",\"description\":\"Search keywords\"},\"k\":{\"type\":\"integer\",\"default\":3},\"max_chars\":{\"type\":\"integer\",\"default\":600},\"page\":{\"type\":\"integer\",\"default\":1},\"exact\":{\"type\":\"boolean\",\"default\":false}},\"required\":[\"query\"]}},{\"name\":\"atex_where\",\"description\":\"Find which files hold something. Call this first instead of grep: it returns ranked file keys with matching line numbers and one best line each, always current with the files on disk. Follow up with atex_recall(key, query) for just the matching lines in one file.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"query\":{\"type\":\"string\"},\"k\":{\"type\":\"integer\",\"default\":3},\"path\":{\"type\":\"string\",\"description\":\"Only files under this folder\"}},\"required\":[\"query\"]}},{\"name\":\"atex_recall\",\"description\":\"Exact-key lookup in the atex knowledge base. Returns the stored text, or the line range given by lines=a-b (as shown by atex_search). Truncated output names the exact remaining line range.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"key\":{\"type\":\"string\"},\"max_chars\":{\"type\":\"integer\",\"default\":2400},\"lines\":{\"type\":\"string\",\"description\":\"Line range a-b\"},\"query\":{\"type\":\"string\",\"description\":\"Return only the lines in this entry that match\"}},\"required\":[\"key\"]}},{\"name\":\"atex_remember\",\"description\":\"Persist a learned fact to the atex knowledge base under namespace manual::.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"key\":{\"type\":\"string\"},\"text\":{\"type\":\"string\"}},\"required\":[\"key\",\"text\"]}},{\"name\":\"atex_list_keys\",\"description\":\"List keys in the atex KB matching a prefix.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"prefix\":{\"type\":\"string\",\"default\":\"\"},\"max\":{\"type\":\"integer\",\"default\":50}}}},{\"name\":\"atex_stats\",\"description\":\"Get atex KB statistics and unbiased context tracker report path for the current conversation.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{}}}]}}\n");
			write_stdout(out[..]);
			flush_stdout();
		} else if m == "ping" {
			var out byte[>..] = [];
			out.append("{\"jsonrpc\":\"2.0\",");
			write_id(out, d, id_node);
			out.append(",\"result\":{}}\n");
			write_stdout(out[..]);
			flush_stdout();
		} else if m == "shutdown" {
			var out byte[>..] = [];
			out.append("{\"jsonrpc\":\"2.0\",");
			write_id(out, d, id_node);
			out.append(",\"result\":null}\n");
			write_stdout(out[..]);
			flush_stdout();
			break;
		} else if m == "tools/call" {
			kb_refresh();
			kb_sweep();
			let p = json::member(d, root, "params");
			let tname, _ = json::as_string(d, json::member(d, p, "name"));
			let args_node = json::member(d, p, "arguments");
			if tname == "atex_where" {
				let q, _ = json::as_string(d, json::member(d, args_node, "query"));
				let kv, okk = json::as_i64(d, json::member(d, args_node, "k"));
				let pv, okp = json::as_string(d, json::member(d, args_node, "path"));
				let res = where_text(q, if okk { kv } else { DEF_K }, if okp { pv } else { "" });
				send_ok_text(d, id_node, res[..], false);
			} else if tname == "atex_search" {
				let q, _ = json::as_string(d, json::member(d, args_node, "query"));
				let kv, okk = json::as_i64(d, json::member(d, args_node, "k"));
				let mv, okm = json::as_i64(d, json::member(d, args_node, "max_chars"));
				let k = if okk { kv } else { DEF_K };
				let mc = if okm { mv } else { DEF_MC };
				let pv, okp = json::as_i64(d, json::member(d, args_node, "page"));
				let xv, okx = json::as_bool(d, json::member(d, args_node, "exact"));
				let pg = if okp { pv } else { 1 };
				let res = if okx && xv { exact_text(q, k, mc, pg) } else { search_text(q, k, mc, pg) };
				send_ok_text(d, id_node, res[..], false);
			} else if tname == "atex_recall" {
				let key, _ = json::as_string(d, json::member(d, args_node, "key"));
				let mv, okm = json::as_i64(d, json::member(d, args_node, "max_chars"));
				let lv, okl = json::as_string(d, json::member(d, args_node, "lines"));
				let qv, okq = json::as_string(d, json::member(d, args_node, "query"));
				let mc = if okm { mv } else { 2400 };
				if !valid_key(key) {
					send_err(d, id_node, -32602, "tool atex_recall invalid input: invalid key");
				} else if kfind(key) < 0 || ENTRIES[kfind(key)].len == 0 {
					send_ok_text(d, id_node, "(not found)", true);
				} else {
					let id = kfind(key);
					let txt = entry_text(id);
					if okq && qv.len > 0 {
						let res = file_query_text(key, txt, qv, if okm { mv } else { DEF_MC });
						send_ok_text(d, id_node, res[..], false);
					} else if okl && lv.len > 0 {
						var res byte[>..] = [];
						var sl byte[>..] = [];
						if slice_lines(txt, lv, sl) {
							res.append(key);
							res.append(" L");
							res.append(trim(lv));
							res.append(" of ");
							format(res, line_of(txt, txt.len));
							res.push('\n');
							res.append(sl[..]);
							send_ok_text(d, id_node, res[..], false);
						} else {
							send_err(d, id_node, -32602, "tool atex_recall invalid input: lines must be \"a-b\" with 1 <= a <= b");
						}
					} else if mc > 0 && txt.len > mc {
						var cut = mc;
						while cut > 0 && txt[cut - 1] != '\n' { cut -= 1; }
						if cut == 0 { cut = mc; }
						let shown = line_of(txt, cut - 1);
						let tot = line_of(txt, txt.len);
						var res byte[>..] = [];
						res.append(txt[..cut]);
						res.append("\n[L1-");
						format(res, shown);
						res.append(" of ");
						format(res, tot);
						res.append("; rest: lines=\"");
						format(res, if txt[cut - 1] == '\n' { shown + 1 } else { shown });
						res.push('-');
						format(res, tot);
						res.append("\" or max_chars=0]");
						send_ok_text(d, id_node, res[..], false);
					} else {
						send_ok_text(d, id_node, txt, false);
					}
				}
			} else if tname == "atex_remember" {
				let skey, _ = json::as_string(d, json::member(d, args_node, "key"));
				let txt, okt = json::as_string(d, json::member(d, args_node, "text"));
				if !valid_key(skey) || !okt || txt.len > 1048576 {
					send_err(d, id_node, -32602, "tool atex_remember invalid input");
				} else if !kb_begin() {
					send_err(d, id_node, -32000, "knowledge base is busy or read-only; nothing was written");
				} else {
					let fk = if starts_with(skey, "manual::") || starts_with(skey, "conv::") { str(skey) } else { str("manual::", skey) };
					save_kb_entry(fk[..], txt);
					kb_unlock();
					if WRITE_OK { send_ok_text(d, id_node, str("remembered as ", fk, " (", txt.len, " bytes)")[..], false); }
					else { send_err(d, id_node, -32000, "could not write to the knowledge base directory"); }
				}
			} else if tname == "atex_list_keys" {
				let pref, _ = json::as_string(d, json::member(d, args_node, "prefix"));
				let mxv, okm = json::as_i64(d, json::member(d, args_node, "max"));
				let mx = if okm { mxv } else { 50 };
				var res byte[>..] = [];
				var cnt = 0;
				for i in 0..ENTRIES.len {
					let k = ekey(i);
					if ENTRIES[i].len > 0 && k.len >= pref.len && k[..pref.len] == pref {
						if cnt > 0 { res.push('\n'); }
						res.append(k);
						cnt += 1;
						if cnt >= mx { break; }
					}
				}
				send_ok_text(d, id_node, if cnt > 0 { res[..] } else { "(no matches)" }, false);
			} else if tname == "atex_stats" {
				let txt = format_stats_line();
				send_ok_text(d, id_node, txt[..], false);
			} else {
				send_err(d, id_node, -32601, str("unknown tool: ", tname)[..]);
			}
		} else if id_node >= 0 {
			send_err(d, id_node, -32601, str("unknown method: ", m)[..]);
		}
		line.clear();
	}
}
```
