import os;
import json;
var BIN byte[>..];
var T byte[>..];
var FAILS = 0;
var RUNS = 0;
fn check(name const byte[:], ok bool) {
	RUNS += 1;
	if !ok {
		FAILS += 1;
		write_stdout(str("FAIL ", name, "\n")[..]);
		flush_stdout();
	}
}
fn has(s const byte[:], w const byte[:]) bool { find(s, w) >= 0 }
fn quote(v const byte[:]) byte[>..] {
	var o = str("'");
	for c in v { if c == '\'' { o.append("'\\''"); } else { o.push(c); } }
	o.push('\'');
	o
}
fn js(s const byte[:]) byte[>..] {
	var b byte[>..] = [];
	json::format_string(b, s);
	b
}
fn slurp(p const byte[:]) byte[>..] {
	var b byte[>..] = [];
	read_file(p, b);
	b
}
fn mkdirs(p const byte[:]) { run_command(str("mkdir -p ", quote(p))[..]); }
fn put(p const byte[:], data const byte[:]) {
	let cut = rfind(p, "/");
	if cut > 0 { mkdirs(p[..cut]); }
	write_file(p, data);
}
fn at_home(home const byte[:], rest const byte[:]) int { run_command(str("HOME=", quote(home), " ", quote(BIN[..]), " ", rest, " > ", quote(str(T, "/last")), " 2>&1")[..]) }
fn call_line(id int, name const byte[:], a const byte[:]) byte[>..] { str("{\"jsonrpc\":\"2.0\",\"id\":", id, ",\"method\":\"tools/call\",\"params\":{\"name\":\"", name, "\",\"arguments\":", a, "}}\n") }
fn replies(raw const byte[:]) byte[>..][>..] {
	var out byte[>..][>..] = [];
	var d = json::Doc {};
	for ln in split(raw, '\n') {
		if ln.len == 0 { continue; }
		let r, _ = json::parse(ln, d);
		let t, _ = json::as_string(d, json::member(d, json::element(d, json::member(d, json::member(d, r, "result"), "content"), 0), "text"));
		out.push(str(t));
	}
	out
}
fn rpc(kb const byte[:], body const byte[:]) byte[>..][>..] {
	let rq = str(T, "/rq");
	let rs = str(T, "/rs");
	write_file(rq[..], body);
	run_command(str(quote(BIN[..]), " serve --atex-dir ", quote(kb), " < ", quote(rq[..]), " > ", quote(rs[..]), " 2>/dev/null")[..]);
	replies(slurp(rs[..])[..])
}
fn one(kb const byte[:], name const byte[:], a const byte[:]) byte[>..] {
	let r = rpc(kb, call_line(1, name, a)[..]);
	if r.len > 0 { copy(r[0]) } else { str("") }
}
fn where(kb const byte[:], q const byte[:], extra const byte[:]) byte[>..] { one(kb, "atex_where", str("{\"query\":", js(q), extra, "}")[..]) }
fn page_used(kb const byte[:]) int {
	var d = json::Doc {};
	let r, _ = json::parse(slurp(str(kb, "/index.json")[..])[..], d);
	let pg = json::member(d, r, "pages");
	let u, _ = json::as_i64(d, json::member(d, json::element(d, pg, json::count(d, pg) - 1), "used_bytes"));
	u
}
fn tree(root const byte[:]) {
	put(str(root, "/src/pkg/auth.py")[..], "import os\ndef verify_token(t):\n    return TOKEN_LIMIT > 7\n");
	put(str(root, "/src/pkg/db.py")[..], "POOL_SIZE = 8\ndef connect():\n    return POOL_SIZE\n");
	put(str(root, "/src/README.md")[..], "# Project\n\nThe pool size is documented here for readers.\n");
	mkdirs(str(root, "/home")[..]);
	at_home(str(root, "/home")[..], str("init ", quote(str(root, "/src")), " --atex-dir ", quote(str(root, "/kb")))[..]);
}
fn test_tiers() {
	let root = str(T, "/tiers");
	tree(root[..]);
	let kb = str(root, "/kb");
	let a = where(kb[..], "POOL_SIZE", "");
	check("where names file, lines, best line", has(a[..], "project::pkg/db.py 2:") && has(a[..], "POOL_SIZE = 8") && !has(a[..], "verify_token"));
	let b = where(kb[..], "pool", ",\"path\":\"pkg/\"");
	check("where filters by folder", has(b[..], "project::pkg/db.py") && !has(b[..], "README"));
	check("where rolls up extra files", has(where(kb[..], "pool", ",\"k\":1")[..], "more files"));
	check("identifier does not match on parts", !has(a[..], "README"));
	check("missing identifier is labeled", has(where(kb[..], "POOL_LIMIT", "")[..], "no exact match for POOL_LIMIT"));
	let c = one(kb[..], "atex_recall", "{\"key\":\"project::pkg/auth.py\",\"query\":\"TOKEN_LIMIT\"}");
	check("recall with query returns matching lines", has(c[..], "TOKEN_LIMIT > 7") && has(c[..], "L2-3"));
	check("recall with no match says so", has(one(kb[..], "atex_recall", "{\"key\":\"project::pkg/auth.py\",\"query\":\"POOL_SIZE\"}")[..], "has no matching lines"));
	let before = page_used(kb[..]);
	sleep_ms(3000);
	at_home(str(root, "/home")[..], str("init ", quote(str(root, "/src")), " --atex-dir ", quote(kb[..]))[..]);
	check("init of an unchanged tree adds nothing", page_used(kb[..]) == before);
}
fn test_fresh() {
	let root = str(T, "/fresh");
	tree(root[..]);
	let kb = str(root, "/kb");
	let db = str(root, "/src/pkg/db.py");
	run_command(str("cp -p ", quote(db[..]), " ", quote(str(root, "/stamp")))[..]);
	write_file(db[..], "POOL_SIZE = 9\ndef connect():\n    return POOL_SIZE\n");
	run_command(str("touch -r ", quote(str(root, "/stamp")), " ", quote(db[..]))[..]);
	check("same-second edit of equal size is seen", has(one(kb[..], "atex_recall", "{\"key\":\"project::pkg/db.py\",\"query\":\"POOL_SIZE\"}")[..], "POOL_SIZE = 9"));
	write_file(db[..], "RENAMED_POOL = 8\n");
	write_file(str(root, "/src/pkg/new.py")[..], "FRESH_SYMBOL = 1\n");
	delete_file(str(root, "/src/pkg/auth.py")[..]);
	check("edit is seen", has(where(kb[..], "RENAMED_POOL", "")[..], "project::pkg/db.py"));
	check("new file is seen", has(where(kb[..], "FRESH_SYMBOL", "")[..], "project::pkg/new.py"));
	check("deleted file is gone from recall", has(one(kb[..], "atex_recall", "{\"key\":\"project::pkg/auth.py\"}")[..], "(not found)"));
	check("deleted file is gone from keys", !has(one(kb[..], "atex_list_keys", "{\"prefix\":\"project::\"}")[..], "project::pkg/auth.py"));
	var body byte[>..] = [];
	for i in 0..40 { body.append("CONCURRENT_EDIT = 1\n"); }
	let before = page_used(kb[..]);
	write_file(db[..], body[..]);
	let rq = str(root, "/rq");
	write_file(rq[..], call_line(1, "atex_where", "{\"query\":\"CONCURRENT_EDIT\"}")[..]);
	var cmd byte[>..] = [];
	for i in 0..7 { cmd.append(str(quote(BIN[..]), " serve --atex-dir ", quote(kb[..]), " < ", quote(rq[..]), " > ", quote(str(root, "/o", i)), " 2>/dev/null & ")[..]); }
	cmd.append("wait");
	run_command(cmd[..]);
	var seen = 0;
	for i in 0..7 { if has(slurp(str(root, "/o", i)[..])[..], "project::pkg/db.py") { seen += 1; } }
	check("seven servers all see one edit", seen == 7);
	check("seven servers index one edit once", page_used(kb[..]) - before == body.len);
	check("no lock is left behind", !file_exists(str(kb, "/write.lock")));
	let hm = str(root, "/homeroot");
	mkdirs(hm[..]);
	at_home(hm[..], str("init ", quote(hm[..]), " --atex-dir ", quote(str(root, "/kb2")))[..]);
	var d = json::Doc {};
	let r, _ = json::parse(slurp(str(root, "/kb2/index.json")[..])[..], d);
	check("home folder is not registered", json::count(d, json::member(d, r, "roots")) == 0);
}
fn test_shared() {
	let root = str(T, "/shared");
	let kb = str(root, "/kb");
	mkdirs(root[..]);
	check("selftest passes", run_command(str(quote(BIN[..]), " --selftest > /dev/null 2>&1")[..]) == 0);
	var cmd byte[>..] = [];
	for i in 0..7 {
		let rq = str(root, "/r", i);
		write_file(rq[..], call_line(1, "atex_remember", str("{\"key\":\"nat", i, "\",\"text\":\"native text ", i, "\"}")[..])[..]);
		cmd.append(str(quote(BIN[..]), " serve --atex-dir ", quote(kb[..]), " < ", quote(rq[..]), " > /dev/null 2>&1 & ")[..]);
	}
	cmd.append("wait");
	run_command(cmd[..]);
	var intact = 0;
	for i in 0..7 { if has(one(kb[..], "atex_recall", str("{\"key\":\"manual::nat", i, "\"}")[..])[..], str("native text ", i)[..]) { intact += 1; } }
	check("seven concurrent writers all survive", intact == 7);
	var hooks byte[>..] = [];
	for i in 0..7 {
		let tp = str(root, "/t", i, ".jsonl");
		write_file(tp[..], str("{\"type\":\"user\",\"message\":{\"content\":\"prompt number ", i, "\"}}\n{\"type\":\"assistant\",\"message\":{\"content\":[{\"type\":\"text\",\"text\":\"reply number ", i, "\"}]}}\n")[..]);
		let inp = str(root, "/h", i);
		write_file(inp[..], str("{\"transcript_path\":", js(tp[..]), ",\"cwd\":\"/proj/shared\"}")[..]);
		hooks.append(str(quote(BIN[..]), " hook stop --atex-dir ", quote(kb[..]), " < ", quote(inp[..]), " > /dev/null 2>&1 & ")[..]);
	}
	hooks.append("wait");
	run_command(hooks[..]);
	let ks = one(kb[..], "atex_list_keys", "{\"prefix\":\"conv::\"}");
	var turns = 0;
	for ln in split(ks[..], '\n') { if has(ln, "turn_") && !has(ln, "latest") { turns += 1; } }
	check("seven concurrent stop hooks all save", turns == 7);
	let sj = str(root, "/sj");
	let so = str(root, "/so");
	let st = str(quote(BIN[..]), " hook start --atex-dir ", quote(kb[..]), " < ", quote(sj[..]), " > ", quote(so[..]), " 2>/dev/null");
	write_file(sj[..], "{\"source\":\"startup\",\"cwd\":\"/proj/shared\"}");
	run_command(st[..]);
	let s0 = slurp(so[..]);
	var sd = json::Doc {};
	let sr, _ = json::parse(s0[..], sd);
	let tip, _ = json::as_string(sd, json::member(sd, json::member(sd, sr, "hookSpecificOutput"), "additionalContext"));
	check("a new session is asked to group tool calls", has(s0[..], "\"hookEventName\":\"SessionStart\"") && find(tip, "[atex] Every reply") == 0 && has(tip, "as few replies") && has(tip, "behind && in the same command") && !has(tip, "Restored working state"));
	run_command(str("ATEX_TIP=0 ", st)[..]);
	check("ATEX_TIP=0 turns that off", slurp(so[..]).len == 0);
	write_file(sj[..], "{\"source\":\"compact\",\"cwd\":\"/proj/shared\"}");
	run_command(st[..]);
	check("after compaction the saved state comes back with it", has(slurp(so[..])[..], "Restored working state") && has(slurp(so[..])[..], "\\n[atex] Every reply"));
	run_command(str("ATEX_TIP=0 ", st)[..]);
	check("the saved state comes back without it too", has(slurp(so[..])[..], "Restored working state") && !has(slurp(so[..])[..], "as few replies"));
	write_file(sj[..], "{\"source\":\"resume\",\"cwd\":\"/proj/shared\"}");
	run_command(st[..]);
	check("a resumed session gets no saved state", has(slurp(so[..])[..], "as few replies") && !has(slurp(so[..])[..], "Restored working state"));
	let two = rpc(kb[..], str(call_line(1, "atex_remember", "{\"key\":\"foo\",\"text\":\"first zebra fact\"}"), call_line(2, "atex_search", "{\"query\":\"zebra\"}"), call_line(3, "atex_remember", "{\"key\":\"foo\",\"text\":\"second giraffe note\"}"), call_line(4, "atex_search", "{\"query\":\"zebra\"}"))[..]);
	check("search forgets overwritten text", two.len == 4 && !has(two[3][..], "giraffe"));
	mkdirs(str(kb, "/write.lock")[..]);
	write_file(str(kb, "/write.lock/owner")[..], "atex");
	run_command(str("touch -d '2 minutes ago' ", quote(str(kb, "/write.lock/owner")))[..]);
	check("a crashed writer's lock is recovered", has(one(kb[..], "atex_remember", "{\"key\":\"after_crash\",\"text\":\"alive\"}")[..], "after_crash") && !file_exists(str(kb, "/write.lock")));
	let bad = str(root, "/bad");
	mkdirs(bad[..]);
	write_file(str(bad, "/index.json")[..], "not json");
	check("a corrupt index fails by exit code", run_command(str(quote(BIN[..]), " stats --atex-dir ", quote(bad[..]), " > /dev/null 2>&1")[..]) != 0);
}
fn test_cursor() {
	let root = str(T, "/cursor");
	var body = str("head\n");
	for i in 0..400 { body.append("lorem "); }
	body.append("\nCONSTRAINT: keep NATIVE_NONCE_4455 exact.\n");
	let notes = str(root, "/src/notes.txt");
	put(notes[..], body[..]);
	let kb = str(root, "/kb");
	run_command(str(quote(BIN[..]), " init ", quote(str(root, "/src")), " --atex-dir ", quote(kb[..]), " > /dev/null 2>&1")[..]);
	let inp = str(root, "/in");
	write_file(inp[..], str("{\"hook_event_name\":\"preToolUse\",\"conversation_id\":\"native-1\",\"tool_name\":\"Read\",\"tool_input\":{\"path\":", js(notes[..]), "}}")[..]);
	let out = str(root, "/out");
	run_command(str(quote(BIN[..]), " hook cursor --atex-dir ", quote(kb[..]), " < ", quote(inp[..]), " > ", quote(out[..]))[..]);
	var d = json::Doc {};
	let r, _ = json::parse(slurp(out[..])[..], d);
	let perm, _ = json::as_string(d, json::member(d, r, "permission"));
	let msg, _ = json::as_string(d, json::member(d, r, "agent_message"));
	check("large Cursor read is replaced by an excerpt", perm == "deny" && has(msg, "NATIVE_NONCE_4455") && msg.len < body.len);
	write_file(inp[..], "{\"hook_event_name\":\"beforeSubmitPrompt\",\"prompt\":\"x\"}");
	run_command(str(quote(BIN[..]), " hook cursor --atex-dir ", quote(kb[..]), " < ", quote(inp[..]), " > ", quote(out[..]))[..]);
	check("Cursor prompts are left alone", has(slurp(out[..])[..], "\"continue\":true") || has(slurp(out[..])[..], "\"continue\": true"));
}
fn test_tool_hook() {
	let root = str(T, "/tool");
	let tp = str(root, "/proj/sess1.jsonl");
	mkdirs(str(root, "/proj")[..]);
	let kb = str(root, "/kb");
	var so byte[>..] = [];
	for i in 1..3001 { if i == 1500 { so.append("1500 ERROR: something broke here\n"); } else { so.append(str(i, "\n")[..]); } }
	let inp = str(root, "/in");
	let out = str(root, "/out");
	let run = str(quote(BIN[..]), " hook tool --atex-dir ", quote(kb[..]), " < ", quote(inp[..]), " > ", quote(out[..]));
	write_file(inp[..], str("{\"session_id\":\"sess1\",\"transcript_path\":", js(tp[..]), ",\"tool_name\":\"Bash\",\"tool_use_id\":\"toolu_abc\",\"tool_input\":{\"command\":\"seq 1 3000\"},\"tool_response\":{\"stdout\":", js(so[..]), ",\"stderr\":\"\",\"interrupted\":false,\"isImage\":false,\"extraField\":7}}")[..]);
	run_command(run[..]);
	var d = json::Doc {};
	let r, _ = json::parse(slurp(out[..])[..], d);
	let upd = json::member(d, json::member(d, r, "hookSpecificOutput"), "updatedToolOutput");
	let s2, _ = json::as_string(d, json::member(d, upd, "stdout"));
	let saved = str(root, "/proj/sess1/tool-results/atex-toolu_abc.txt");
	check("long Bash output is shortened", s2.len <= 4200 && s2.len > 0);
	check("the note names the saved file", has(s2, saved[..]));
	check("the error line in the middle is kept", has(s2, "1500 ERROR: something broke here"));
	check("the head and tail are kept", starts_with(s2, "1\n2\n") && has(s2, "\n3000\n"));
	check("other output fields are kept", json::member(d, upd, "extraField") >= 0 && json::member(d, upd, "interrupted") >= 0);
	check("the full output is saved", slurp(saved[..]) == so);
	write_file(inp[..], "{\"tool_name\":\"Bash\",\"tool_input\":{\"command\":\"ls\"},\"tool_response\":{\"stdout\":\"small\",\"stderr\":\"\"}}");
	run_command(run[..]);
	check("small output is left alone", slurp(out[..]).len == 0);
	write_file(inp[..], str("{\"tool_name\":\"Bash\",\"tool_input\":{\"command\":", js(str("sed -n 1,3000p ", saved)[..]), "},\"tool_response\":{\"stdout\":", js(so[..]), ",\"stderr\":\"\"}}")[..]);
	run_command(run[..]);
	check("reading the saved file back is not shortened again", slurp(out[..]).len == 0);
	write_file(inp[..], str("{\"tool_name\":\"Read\",\"tool_input\":{\"file_path\":\"/x\"},\"tool_response\":{\"stdout\":", js(so[..]), "}}")[..]);
	run_command(run[..]);
	check("other tools are left alone", slurp(out[..]).len == 0);
	write_file(inp[..], str("{\"tool_name\":\"Bash\",\"tool_input\":{\"command\":\"seq\"},\"tool_response\":{\"stdout\":", js(so[..]), ",\"stderr\":\"\"}}")[..]);
	run_command(str("ATEX_TOOL_CAP=0 ", run)[..]);
	check("the cap can be turned off", slurp(out[..]).len == 0);
	run_command(run[..]);
	check("no transcript falls back to the knowledge base", has(slurp(out[..])[..], str(kb, "/out/atex-")[..]));
}
fn test_install() {
	let root = str(T, "/install");
	let hm = str(root, "/home");
	let kb = str(root, "/kb");
	let set = str(hm, "/.claude/settings.json");
	put(set[..], "{\n  \"model\": \"opus\",\n  \"env\": {\"KEEP_ME\": \"1\", \"N\": 7},\n  \"hooks\": {\n    \"Stop\": [{\"hooks\": [{\"type\": \"command\", \"command\": \"other-tool done\"}, {\"type\": \"command\", \"command\": \"'/old/atex' hook stop --atex-dir '/old/kb'\"}]}],\n    \"SessionStart\": [{\"matcher\": \"clear|compact\", \"hooks\": [{\"type\": \"command\", \"command\": \"'/old/atex' hook start --atex-dir '/old/kb'\"}]}],\n    \"PreToolUse\": [{\"matcher\": \"Edit\", \"hooks\": [{\"type\": \"command\", \"command\": \"lint-it\"}]}]\n  },\n  \"permissions\": {\"allow\": [\"Bash(ls:*)\"]}\n}\n");
	put(str(hm, "/.claude.json")[..], "{\"mcpServers\":{\"other\":{\"command\":\"x\"}},\"numStartups\":7}\n");
	mkdirs(str(hm, "/.cursor")[..]);
	let ins = str("install --atex-dir ", quote(kb[..]));
	at_home(hm[..], "doctor");
	check("doctor asks for a new install while the start hook has its old matcher", has(slurp(str(T, "/last")[..])[..], "ok hook that restores state") && has(slurp(str(T, "/last")[..])[..], "missing that hook runs in every session"));
	check("install succeeds", at_home(hm[..], ins[..]) == 0);
	let s1 = slurp(set[..]);
	var d = json::Doc {};
	let r, _ = json::parse(s1[..], d);
	check("settings stay valid JSON", r >= 0);
	let w, _ = json::as_string(d, json::member(d, json::member(d, r, "env"), "CLAUDE_CODE_AUTO_COMPACT_WINDOW"));
	check("the compact window is set", w == "283000");
	check("unrelated settings survive", has(s1[..], "KEEP_ME") && has(s1[..], "other-tool done") && has(s1[..], "lint-it") && has(s1[..], "Bash(ls:*)") && has(s1[..], "\"model\""));
	check("old atex hooks are replaced", !has(s1[..], "/old/kb") && has(s1[..], " hook stop --atex-dir") && has(s1[..], " hook start --atex-dir") && has(s1[..], " hook tool --atex-dir"));
	check("the start hook runs in every session", !has(s1[..], "clear|compact"));
	check("doctor passes", at_home(hm[..], "doctor") == 0);
	check("doctor reports one knowledge base", has(slurp(str(T, "/last")[..])[..], "ok one knowledge base"));
	at_home(hm[..], ins[..]);
	check("install twice changes nothing", slurp(set[..]) == s1);
	at_home(hm[..], str(ins, " --no-compact-window")[..]);
	check("the compact window can be turned off", !has(slurp(set[..])[..], "CLAUDE_CODE_AUTO_COMPACT_WINDOW"));
	let own = str(root, "/own.json");
	put(own[..], "{\"env\":{\"CLAUDE_CODE_AUTO_COMPACT_WINDOW\":\"400000\"}}");
	run_command(str("cp ", quote(own[..]), " ", quote(set[..]))[..]);
	at_home(hm[..], ins[..]);
	check("a window you set yourself is kept", has(slurp(set[..])[..], "400000") && !has(slurp(set[..])[..], "283000"));
	at_home(hm[..], "uninstall");
	let s2 = slurp(set[..]);
	check("uninstall removes the hooks", !has(s2[..], " hook stop") && !has(s2[..], " hook tool"));
	check("uninstall keeps a window you set yourself", has(s2[..], "400000"));
	check("uninstall removes the MCP server only", !has(slurp(str(hm, "/.claude.json")[..])[..], "amnitex") && has(slurp(str(hm, "/.claude.json")[..])[..], "other"));
	check("uninstall removes Cursor files", !file_exists(str(hm, "/.cursor/hooks/atex-cursor")) && !file_exists(str(hm, "/.cursor/rules/amnitex.mdc")));
	check("doctor fails after uninstall", at_home(hm[..], "doctor") != 0);
	let bad = str(root, "/badhome");
	put(str(bad, "/.claude/settings.json")[..], "{ not json");
	at_home(bad[..], ins[..]);
	check("broken settings are left unchanged", slurp(str(bad, "/.claude/settings.json")[..]) == "{ not json");
}
fn test_replay() {
	let root = str(T, "/replay");
	let dir = str(root, "/projects/p");
	mkdirs(dir[..]);
	var t byte[>..] = [];
	var ctx = 60000;
	for i in 0..400 {
		t.append(str("{\"type\":\"assistant\",\"message\":{\"id\":\"m", i, "\",\"usage\":{\"input_tokens\":1,\"cache_read_input_tokens\":", ctx, ",\"cache_creation_input_tokens\":0,\"output_tokens\":7},\"content\":[{\"type\":\"tool_use\",\"id\":\"t", i, "\",\"name\":\"Bash\",\"input\":{\"command\":\"x\"}}]}}\n")[..]);
		var body byte[>..] = [];
		body.resize(20000, 'x');
		t.append(str("{\"type\":\"user\",\"message\":{\"content\":[{\"type\":\"tool_result\",\"tool_use_id\":\"t", i, "\",\"content\":\"", body, "\"}", if i % 4 == 0 { ",{\"type\":\"tool_result\",\"tool_use_id\":\"u\",\"content\":\"y\"}" } else { "" }, "]}}\n")[..]);
		ctx += 7000;
	}
	write_file(str(dir, "/s.jsonl")[..], t[..]);
	let hm = str(root, "/home");
	mkdirs(hm[..]);
	check("replay runs", at_home(hm[..], str("replay ", quote(str(root, "/projects")))[..]) == 0);
	let o = slurp(str(T, "/last")[..]);
	check("replay finds the session", has(o[..], "sessions=1") && has(o[..], "calls=400"));
	check("replay counts replies that follow one tool call", has(o[..], "one_call_replies=74.9%"));
	check("replay lists the settings", has(o[..], "compact at 250K") && has(o[..], "cap Bash 2K") && has(o[..], "fresh turn"));
	check("replay creates no knowledge base", !is_dir(str(hm, "/.atex")));
	check("replay reports a missing folder", at_home(hm[..], str("replay ", quote(str(root, "/nope")))[..]) != 0);
}
fn run_call(id const byte[:], ctx int) byte[>..] { str("{\"type\":\"assistant\",\"message\":{\"id\":", js(id), ",\"content\":[],\"usage\":{\"input_tokens\":", ctx, ",\"cache_read_input_tokens\":0,\"cache_creation_input_tokens\":0,\"output_tokens\":5}}}\n") }
fn run_end_line(sub const byte[:], bad const byte[:], why const byte[:], text const byte[:]) byte[>..] { str("{\"type\":\"result\",\"subtype\":", js(sub), ",\"is_error\":", bad, ",\"terminal_reason\":", js(why), ",\"session_id\":\"sid-1\",\"result\":", js(text), ",\"total_cost_usd\":0.248,\"permission_denials\":[{\"tool_name\":\"Bash\"}],\"usage\":{\"input_tokens\":1000,\"cache_read_input_tokens\":2000,\"cache_creation_input_tokens\":3000,\"output_tokens\":40}}\n") }
fn run_fake(root const byte[:], replies const byte[>..][:]) {
	run_command(str("rm -rf ", quote(root))[..]);
	mkdirs(str(root, "/bin")[..]);
	let f = str(root, "/bin/claude");
	write_file(f[..], str("#!/bin/sh\nd=", quote(root), "\nn=$(cat \"$d/n\" 2>/dev/null || echo 0)\nn=$((n+1))\necho $n > \"$d/n\"\necho \"$*\" > \"$d/args.$n\"\necho \"$CLAUDE_CODE_PROMPT_CACHE_TTL\" > \"$d/ttl.$n\"\ncat > \"$d/in.$n\"\ncat \"$d/out.$n\" 2>/dev/null\nexit $(cat \"$d/rc.$n\" 2>/dev/null || echo 0)\n")[..]);
	make_exec(f[..]);
	var i = 1;
	for r in replies {
		write_file(str(root, "/out.", i)[..], r[..]);
		i += 1;
	}
}
fn run_go(root const byte[:], rest const byte[:]) int { run_command(str("HOME=", quote(root), " PATH=", quote(str(root, "/bin")[..]), ":$PATH ", quote(BIN[..]), " run --atex-dir ", quote(str(root, "/kb")[..]), " ", rest, " > ", quote(str(root, "/so")), " 2> ", quote(str(root, "/se")))[..]) }
fn test_run() {
	let root = str(T, "/run");
	var rs byte[>..][>..] = [];
	rs.push(str(run_call("m1", 5000), run_call("m1", 5000), run_call("m2", 20000), run_end_line("success", "false", "hook_stopped", "")));
	rs.push(run_end_line("success", "false", "completed", "CONTINUE\nnext step is the widget"));
	rs.push(str(run_call("m3", 7000), run_call("m4", 9000), run_end_line("success", "false", "completed", "all done here")));
	run_fake(root[..], rs[..]);
	check("run finishes a cut task", run_go(root[..], "'fix the widget'") == 0);
	check("run prints the last part's reply", has(slurp(str(root, "/so")[..])[..], "all done here"));
	let a1 = slurp(str(root, "/args.1")[..]);
	check("run starts lean", has(a1[..], "--strict-mcp-config") && has(a1[..], "--setting-sources") && has(a1[..], "--disable-slash-commands") && has(a1[..], "--tools Bash,Read,Edit,Write,Grep,Glob") && has(a1[..], "--max-turns 133"));
	check("run uses the 5-minute cache", slurp(str(root, "/ttl.1")[..]) == "5m\n" && slurp(str(root, "/ttl.2")[..]) == "5m\n");
	check("run does not skip permissions unless told", !has(a1[..], "--dangerously-skip-permissions") && has(a1[..], "--permission-mode acceptEdits"));
	let a2 = slurp(str(root, "/args.2")[..]);
	check("notes resume the same session for one call", has(a2[..], "--resume sid-1") && has(a2[..], "--max-turns 1"));
	check("part 1 gets the task alone", slurp(str(root, "/in.1")[..]) == "fix the widget");
	let in3 = slurp(str(root, "/in.3")[..]);
	check("the next part gets the task and the notes", has(in3[..], "fix the widget") && has(in3[..], "next step is the widget") && has(in3[..], "part 2"));
	let se = slurp(str(root, "/se")[..]);
	check("run reports each part and the cut", has(se[..], "Part 1: 2 calls, context 5K to 20K, cut.") && has(se[..], "Part 2: 2 calls"));
	check("run adds up every call", has(se[..], "2 parts, 5 calls. Input 18K (6K from cache, 12K new), output 0K, API price $0.50."));
	check("run makes no savings claim it did not measure", !has(se[..], "modeled") && !has(se[..], "% less"));
	check("run says when tools were refused", has(se[..], "3 tool calls were refused") && has(se[..], "--allow-all"));
	let rid = run_id(root[..]);
	let rd = str(root, "/kb/runs/", rid);
	check("raw logs stay out of git", slurp(str(root, "/kb/runs/.gitignore")[..]) == "*\n");
	check("run keeps the logs and notes on disk", has(slurp(str(rd, "/part-1.notes.txt")[..])[..], "next step") && file_exists(str(rd, "/part-1.jsonl")[..]) && file_exists(str(rd, "/part-1.notes.jsonl")[..]));
	check("the cut hook is wired for every tool", has(slurp(str(rd, "/settings.json")[..])[..], "\"matcher\":\"\"") && has(slurp(str(rd, "/settings.json")[..])[..], "ATEX_RUN_CUT=40000"));
	check("notes go to the knowledge base", has(one(str(root, "/kb")[..], "atex_recall", str("{\"key\":\"run::", rid, "::part_1\"}")[..])[..], "next step is the widget"));
	check("the result goes to the knowledge base", has(one(str(root, "/kb")[..], "atex_recall", str("{\"key\":\"run::", rid, "::result\"}")[..])[..], "all done here"));
	rs.clear();
	rs.push(str(run_call("m1", 5000), run_end_line("success", "false", "hook_stopped", "")));
	rs.push(run_end_line("success", "false", "completed", "DONE\nall of it works"));
	run_fake(root[..], rs[..]);
	check("notes that say done end the run", run_go(root[..], "--allow-all --cut 9000 task -- --model haiku --effort 'low'") == 0 && !file_exists(str(root, "/args.3")[..]) && slurp(str(root, "/so")[..]) == "all of it works\n");
	let a3 = slurp(str(root, "/args.1")[..]);
	check("--allow-all and passed flags reach claude", has(a3[..], "--dangerously-skip-permissions") && has(a3[..], "--model haiku --effort low") && has(a3[..], "--max-turns 30"));
	run_fake(root[..], rs[..]);
	check("a cache setting you chose is kept", run_command(str("CLAUDE_CODE_PROMPT_CACHE_TTL=1h HOME=", quote(root[..]), " PATH=", quote(str(root, "/bin")[..]), ":$PATH ", quote(BIN[..]), " run --atex-dir ", quote(str(root, "/kb")[..]), " task > /dev/null 2>&1")[..]) == 0 && slurp(str(root, "/ttl.1")[..]) == "1h\n");
	rs.clear();
	rs.push(str(run_call("m1", 5000), run_end_line("error_max_turns", "true", "max_turns", "")));
	rs.push(run_end_line("error_max_turns", "true", "max_turns", ""));
	rs.push(run_end_line("success", "false", "completed", "finished"));
	run_fake(root[..], rs[..]);
	write_file(str(root, "/rc.1")[..], "1\n");
	check("hitting the turn limit counts as a cut", run_go(root[..], "task") == 0 && has(slurp(str(root, "/in.3")[..])[..], "No notes were written") && has(slurp(str(root, "/so")[..])[..], "finished"));
	rs.clear();
	rs.push(str(run_call("m1", 5000), run_end_line("success", "false", "hook_stopped", "")));
	rs.push(run_end_line("success", "false", "completed", "CONTINUE\nmore"));
	run_fake(root[..], rs[..]);
	check("the part limit stops an unfinished task", run_go(root[..], "--parts 1 task") == 3 && has(slurp(str(root, "/se")[..])[..], "unfinished"));
	rs.clear();
	rs.push(run_end_line("error_during_execution", "true", "error", "usage limit reached"));
	run_fake(root[..], rs[..]);
	write_file(str(root, "/rc.1")[..], "1\n");
	check("an error stops the run and says why", run_go(root[..], "task") == 1 && has(slurp(str(root, "/se")[..])[..], "usage limit reached"));
	rs.clear();
	run_fake(root[..], rs[..]);
	write_file(str(root, "/rc.1")[..], "7\n");
	check("a claude that prints nothing fails the run", run_go(root[..], "task") == 1);
	check("run needs a task", run_go(root[..], "") == 2);
	check("run refuses a bad cut", run_go(root[..], "--cut lots task") == 2);
	check("run refuses an unknown option", run_go(root[..], "--nope task") == 2);
	mkdirs(str(root, "/hk")[..]);
	let tp = str(root, "/hk/s.jsonl");
	let hi = str(root, "/hk/in");
	let ho = str(root, "/hk/out");
	write_file(tp[..], str(run_call("m1", 5000), run_call("m2", 12000))[..]);
	write_file(hi[..], str("{\"session_id\":\"s\",\"transcript_path\":", js(tp[..]), ",\"tool_name\":\"Read\",\"tool_use_id\":\"t\",\"tool_input\":{},\"tool_response\":{}}")[..]);
	let hook = fn_hook_cmd(hi[..], ho[..]);
	run_command(str("ATEX_RUN_CUT=7000 ", hook)[..]);
	check("the hook cuts once context grew past the limit", has(slurp(ho[..])[..], "\"continue\":false"));
	run_command(str("ATEX_RUN_CUT=7001 ", hook)[..]);
	check("the hook stays quiet under the limit", slurp(ho[..]).len == 0);
	run_command(hook[..]);
	check("the hook never cuts outside a run", slurp(ho[..]).len == 0);
	var big byte[>..] = [];
	for i in 1..3001 { big.append(str(i, "\n")[..]); }
	write_file(hi[..], str("{\"session_id\":\"s\",\"transcript_path\":", js(tp[..]), ",\"tool_name\":\"Bash\",\"tool_use_id\":\"t\",\"tool_input\":{\"command\":\"seq\"},\"tool_response\":{\"stdout\":", js(big[..]), ",\"stderr\":\"\"}}")[..]);
	run_command(str("ATEX_RUN_CUT=7000 ", hook)[..]);
	var d = json::Doc {};
	let r, _ = json::parse(slurp(ho[..])[..], d);
	let so, _ = json::as_string(d, json::member(d, json::member(d, json::member(d, r, "hookSpecificOutput"), "updatedToolOutput"), "stdout"));
	let go, _ = json::as_bool(d, json::member(d, r, "continue"));
	check("the hook can cap and cut in one reply", r >= 0 && !go && json::member(d, r, "continue") >= 0 && so.len > 0 && so.len < 4300);
	run_command(hook[..]);
	var d2 = json::Doc {};
	let r2, _ = json::parse(slurp(ho[..])[..], d2);
	check("capping alone still works", r2 >= 0 && json::member(d2, r2, "continue") < 0 && json::member(d2, r2, "hookSpecificOutput") >= 0);
}
fn fn_hook_cmd(i const byte[:], o const byte[:]) byte[>..] { str(quote(BIN[..]), " hook tool < ", quote(i), " > ", quote(o)) }
fn run_id(root const byte[:]) byte[>..] {
	var names byte[>..] = [];
	list_dir(str(root, "/kb/runs")[..], names);
	var rid byte[>..] = [];
	for nm in split(names[..], '\n') { if nm.len > 0 && nm[0] != '.' { rid = str(nm); } }
	rid
}
fn batch_in(tp const byte[:], calls const byte[:]) byte[>..] { str("{\"session_id\":\"s\",\"transcript_path\":", js(tp), ",\"hook_event_name\":\"PostToolBatch\",\"tool_calls\":[", calls, "]}") }
fn test_check() {
	let root = str(T, "/chk");
	let fr = str(T, "/chkrun");
	let rd = str(root, "/kb/runs/r1");
	let chk = str(root, "/chk.sh");
	let tp = str(root, "/s.jsonl");
	let hi = str(root, "/in");
	let ho = str(root, "/out");
	mkdirs(rd[..]);
	mkdirs(str(root, "/proj")[..]);
	write_file(chk[..], "#!/bin/sh\nd=$(dirname \"$0\")\nn=$(cat \"$d/cn\" 2>/dev/null || echo 0)\nn=$((n+1))\necho $n > \"$d/cn\"\npwd\ncat \"$d/say\" 2>/dev/null\n[ $n -ge $(cat \"$d/need\") ]\n");
	make_exec(chk[..]);
	write_file(str(root, "/need")[..], "99\n");
	write_file(str(root, "/say")[..], "FAIL thing\n");
	write_file(str(rd, "/check.cmd")[..], str(chk, "\n")[..]);
	write_file(str(rd, "/pwd.txt")[..], str(root, "/proj\n")[..]);
	write_file(tp[..], str(run_call("m1", 5000), run_call("m2", 12000))[..]);
	let edit = "{\"tool_name\":\"Edit\",\"tool_input\":{\"file_path\":\"/x\"},\"tool_use_id\":\"t1\",\"tool_response\":\"ok\"}";
	let read = "{\"tool_name\":\"Read\",\"tool_input\":{\"file_path\":\"/x\"},\"tool_use_id\":\"t2\",\"tool_response\":\"x\"}";
	let own = str("{\"tool_name\":\"Bash\",\"tool_input\":{\"command\":", js(str(chk, " 2>&1 | tail -n 3")[..]), "},\"tool_use_id\":\"t3\",\"tool_response\":\"x\"}");
	let hook = str("ATEX_RUN_DIR=", quote(rd[..]), " ", fn_hook_cmd(hi[..], ho[..]));
	write_file(hi[..], batch_in(tp[..], str(edit, ",", read)[..])[..]);
	run_command(str("ATEX_RUN_CUT=7001 ", hook)[..]);
	var d = json::Doc {};
	let r, _ = json::parse(slurp(ho[..])[..], d);
	let hs = json::member(d, r, "hookSpecificOutput");
	let ev, _ = json::as_string(d, json::member(d, hs, "hookEventName"));
	let ctx, _ = json::as_string(d, json::member(d, hs, "additionalContext"));
	check("an edit makes atex run the check and show the result", ev == "PostToolBatch" && has(ctx, "gave exit code 1") && has(ctx, "FAIL thing") && json::member(d, r, "continue") < 0);
	check("the check runs in the folder the run started in", has(ctx, str(root, "/proj")[..]));
	check("the check hook leaves a marker for the cut", file_exists(str(rd, "/batch.ok")[..]));
	write_file(hi[..], batch_in(tp[..], read)[..]);
	run_command(str("ATEX_RUN_CUT=7001 ", hook)[..]);
	check("a reply with no edits runs no check", slurp(ho[..]).len == 0 && slurp(str(root, "/cn")[..]) == "1\n");
	write_file(hi[..], batch_in(tp[..], str(edit, ",", own)[..])[..]);
	run_command(str("ATEX_RUN_CUT=7001 ", hook)[..]);
	check("a check the agent ran after its edits is not run twice", slurp(ho[..]).len == 0 && slurp(str(root, "/cn")[..]) == "1\n");
	write_file(hi[..], batch_in(tp[..], str(own, ",", edit)[..])[..]);
	run_command(str("ATEX_RUN_CUT=7001 ", hook)[..]);
	check("an edit after the agent's own check is checked", has(slurp(ho[..])[..], "gave exit code 1") && slurp(str(root, "/cn")[..]) == "2\n");
	write_file(hi[..], batch_in(tp[..], edit)[..]);
	run_command(str("ATEX_RUN_CUT=7000 ", hook)[..]);
	check("the check hook can cut and report in one reply", has(slurp(ho[..])[..], "\"continue\":false") && has(slurp(ho[..])[..], "additionalContext"));
	write_file(str(root, "/need")[..], "1\n");
	write_file(str(root, "/say")[..], "all 12 passed\n");
	run_command(str("ATEX_RUN_CUT=7001 ", hook)[..]);
	check("a passing check shows its last lines", has(slurp(ho[..])[..], "gave exit code 0") && has(slurp(ho[..])[..], "all 12 passed"));
	var big byte[>..] = [];
	for i in 1..3001 { big.append(str("line ", i, "\n")[..]); }
	write_file(str(root, "/say")[..], big[..]);
	write_file(str(root, "/need")[..], "99\n");
	run_command(str("ATEX_RUN_CUT=7001 ", hook)[..]);
	check("long check output is cut down and kept in a file", slurp(ho[..]).len > 0 && slurp(ho[..]).len < 2400 && has(slurp(ho[..])[..], "Full output") && has(slurp(str(rd, "/check.txt")[..])[..], "line 1500\n"));
	write_file(hi[..], str("{\"session_id\":\"s\",\"transcript_path\":", js(tp[..]), ",\"tool_name\":\"Read\",\"tool_use_id\":\"t\",\"tool_input\":{},\"tool_response\":{}}")[..]);
	run_command(str("ATEX_RUN_CUT=7000 ", hook)[..]);
	check("with the check hook working, the per-tool hook leaves the cut to it", slurp(ho[..]).len == 0);
	delete_file(str(rd, "/batch.ok")[..]);
	run_command(str("ATEX_RUN_CUT=7000 ", hook)[..]);
	check("without it, the per-tool hook still cuts", has(slurp(ho[..])[..], "\"continue\":false"));
	write_file(str(rd, "/check.cmd")[..], "sleep 5\n");
	write_file(hi[..], batch_in(tp[..], edit)[..]);
	run_command(str("ATEX_CHECK_SECS=1 ATEX_RUN_CUT=7001 ", hook)[..]);
	check("a check that hangs is stopped", run_command("command -v timeout > /dev/null 2>&1") != 0 || has(slurp(ho[..])[..], "did not finish in 1 s"));
	let opt = str("--check ", quote(chk[..]), " task");
	var rs byte[>..][>..] = [];
	rs.push(str(run_call("m1", 5000), run_call("m2", 7000), run_end_line("success", "false", "completed", "all done")));
	rs.push(str(run_call("m3", 8000), run_end_line("success", "false", "completed", "fixed it")));
	run_fake(fr[..], rs[..]);
	delete_file(str(root, "/cn")[..]);
	write_file(str(root, "/need")[..], "2\n");
	write_file(str(root, "/say")[..], "FAIL widget\n");
	check("a failing check sends the agent back to fix it", run_go(fr[..], opt[..]) == 0 && slurp(str(fr, "/so")[..]) == "fixed it\n");
	let in2 = slurp(str(fr, "/in.2")[..]);
	check("the fix round resumes the same session with the failure", has(slurp(str(fr, "/args.2")[..])[..], "--resume sid-1") && has(slurp(str(fr, "/args.2")[..])[..], "--max-turns 133") && has(in2[..], "FAIL widget") && has(in2[..], "gave exit code 1"));
	let se = slurp(str(fr, "/se")[..]);
	check("run says the check passed and counts the fix round", has(se[..], str("Check passed: ", chk)[..]) && has(se[..], "Part 1, fix 1: 1 calls") && has(se[..], "1 part, 3 calls. Input 12K (4K from cache, 8K new), output 0K, API price $0.25."));
	check("run says when the check hook never ran", has(se[..], "did not run the check after edits"));
	let cfg = slurp(str(fr, "/kb/runs/", run_id(fr[..]), "/settings.json")[..]);
	var dc = json::Doc {};
	let rc, _ = json::parse(trim(cfg[..]), dc);
	check("--check wires the check hook", rc >= 0 && json::count(dc, json::member(dc, json::member(dc, rc, "hooks"), "PostToolBatch")) == 1 && has(cfg[..], "ATEX_RUN_DIR=") && has(cfg[..], "\"timeout\":300") && has(cfg[..], "\"matcher\":\"\""));
	check("--check tells the agent about the check", has(slurp(str(fr, "/kb/runs/", run_id(fr[..]), "/system.txt")[..])[..], str("Check command: ", chk)[..]));
	rs.clear();
	rs.push(str(run_call("m1", 5000), run_end_line("success", "false", "completed", "all done")));
	rs.push(str(run_call("m2", 5000), run_end_line("success", "false", "completed", "try 1")));
	rs.push(str(run_call("m3", 5000), run_end_line("success", "false", "completed", "try 2")));
	run_fake(fr[..], rs[..]);
	write_file(str(root, "/need")[..], "99\n");
	check("a check that keeps failing ends the run with its own exit code", run_go(fr[..], opt[..]) == 4 && !file_exists(str(fr, "/args.4")[..]) && has(slurp(str(fr, "/se")[..])[..], "still fails after 2 fix rounds") && slurp(str(fr, "/so")[..]) == "try 2\n");
	rs.clear();
	rs.push(str(run_call("m1", 5000), run_end_line("success", "false", "hook_stopped", "")));
	rs.push(run_end_line("success", "false", "completed", "DONE\nall of it works"));
	rs.push(str(run_call("m2", 5000), run_end_line("success", "false", "completed", "now it works")));
	run_fake(fr[..], rs[..]);
	delete_file(str(root, "/cn")[..]);
	write_file(str(root, "/need")[..], "2\n");
	check("notes that say done are checked before the run ends", run_go(fr[..], opt[..]) == 0 && has(slurp(str(fr, "/in.3")[..])[..], "the check fails") && has(slurp(str(fr, "/in.3")[..])[..], "all of it works") && slurp(str(fr, "/so")[..]) == "now it works\n");
	rs.clear();
	rs.push(str(run_call("m1", 5000), run_end_line("success", "false", "completed", "plain")));
	run_fake(fr[..], rs[..]);
	write_file(str(root, "/need")[..], "1\n");
	check("a passing check ends the run at once", run_go(fr[..], opt[..]) == 0 && !file_exists(str(fr, "/args.2")[..]) && has(slurp(str(fr, "/se")[..])[..], "Check passed"));
	run_fake(fr[..], rs[..]);
	check("without --check nothing is added", run_go(fr[..], "task") == 0 && !has(slurp(str(fr, "/kb/runs/", run_id(fr[..]), "/settings.json")[..])[..], "PostToolBatch") && !has(slurp(str(fr, "/kb/runs/", run_id(fr[..]), "/settings.json")[..])[..], "ATEX_RUN_DIR") && !has(slurp(str(fr, "/se")[..])[..], "Check"));
	check("--check needs a command", run_go(fr[..], "task --check") == 2);
}
fn test_versions(repo const byte[:]) {
	run_command(str(quote(BIN[..]), " --version > ", quote(str(T, "/v")))[..]);
	let line = slurp(str(T, "/v")[..]);
	let parts = split(line[..], ' ');
	let v = if parts.len > 1 { str(parts[1]) } else { str("?") };
	for f in ["gemini-extension.json", "manifest.json", "plugin.json", "server.json", ".claude-plugin/plugin.json", ".claude-plugin/marketplace.json", ".grok-plugin/plugin.json", ".grok-plugin/marketplace.json", ".codex-plugin/plugin.json", ".cursor-plugin/plugin.json"] {
		check(str("version in ", f)[..], has(slurp(str(repo, "/", f)[..])[..], str("\"", v, "\"")[..]));
	}
	let vkb = str(T, "/kbv");
	let vinit = rpc(vkb[..], "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\",\"params\":{}}\n");
	check("the server reports the same version", vinit.len > 0 && has(slurp(str(T, "/rs")[..])[..], str("\"version\":\"", v, "\"")[..]));
	run_command(str(quote(BIN[..]), " bench ", quote(str(repo, "/bench/lookup_heldout.tsv")), " --atex-dir ", quote(vkb[..]), " > ", quote(str(T, "/bv")), " 2>/dev/null")[..]);
	check("atex bench reports the same version", has(slurp(str(T, "/bv")[..])[..], str("\"engine\":\"atex ", v, "\"")[..]));
	check("an unknown command fails instead of waiting", run_command(str(quote(BIN[..]), " nosuchcommand < /dev/null > /dev/null 2>&1")[..]) != 0);
	check("the plugin start hook runs in every session", has(slurp(str(repo, "/hooks/hooks.json")[..])[..], "atex hook start") && !has(slurp(str(repo, "/hooks/hooks.json")[..])[..], "clear|compact"));
	check("no Python is left in the repository",run_command(str("cd ", quote(repo), " && ! git ls-files | grep -q -E '\\.py$|pyproject'")[..]) == 0);
}
fn main() {
	let av = args();
	if av.len < 3 {
		write_stderr("usage: atex_test <atex binary> <repository folder>\n");
		exit(2);
	}
	BIN.append(av[1]);
	T.append(str("/tmp/atex-test-", time_ns()));
	mkdirs(T[..]);
	test_tiers();
	test_fresh();
	test_shared();
	test_cursor();
	test_tool_hook();
	test_install();
	test_replay();
	test_run();
	test_check();
	test_versions(av[2]);
	run_command(str("rm -rf ", quote(T[..]))[..]);
	write_stdout(str(RUNS - FAILS, " of ", RUNS, " checks passed\n")[..]);
	flush_stdout();
	exit(if FAILS == 0 { 0 } else { 1 });
}
